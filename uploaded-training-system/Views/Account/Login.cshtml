@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول - إدارة البرامج التدريبية</title>
    
    <!-- Fonts -->
      <link  href="~/font/notosansarabic-variablefont_wdth,wght.ttf"/>
    
    <!-- Bootstrap Icons -->
 <link href="~/font/bootstrap-icons.min.css" rel="stylesheet" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="login-container">
        <div class="login-card animate-slideIn">
            <!-- Header -->
            <div class="login-header">
                <div class="login-logo">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <h1>إدارة البرامج التدريبية</h1>
                <p>تسجيل دخول المدير</p>
            </div>

            <!-- Body -->
            <div class="login-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <form method="post">
                    <div class="form-group">
                        <label class="form-label">اسم المستخدم</label>
                        <div style="position: relative;">
                            <input type="text" name="username" class="form-control" placeholder="أدخل اسم المستخدم" required style="padding-right: 2.5rem;" />
                            <i class="bi bi-person" style="position: absolute; right: 0.875rem; top: 50%; transform: translateY(-50%); color: var(--muted-foreground);"></i>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">كلمة المرور</label>
                        <div style="position: relative;">
                            <input type="password" name="password" class="form-control" placeholder="أدخل كلمة المرور" required style="padding-right: 2.5rem;" />
                            <i class="bi bi-lock" style="position: absolute; right: 0.875rem; top: 50%; transform: translateY(-50%); color: var(--muted-foreground);"></i>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-lg mb-3">
                        <i class="bi bi-box-arrow-in-left me-2"></i>
                        دخول
                    </button>

                    <div class="text-center">
                        <a href="@Url.Action("Index", "Home")" style="color: var(--primary); text-decoration: none;">
                            <i class="bi bi-arrow-right me-1"></i>
                            العودة للصفحة الرئيسية
                        </a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</body>
</html>
