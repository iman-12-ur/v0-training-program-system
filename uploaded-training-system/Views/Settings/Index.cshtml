@model SystemSettings
@{
    ViewData["Title"] = "الإعدادات";
    var users = ViewBag.Users as List<ApplicationUser>;
}

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-title">الإعدادات</h1>
    <p class="page-subtitle">إعدادات النظام العامة</p>
</div>

<div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;">
    <!-- System Settings -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="bi bi-sliders me-2"></i>
                إعدادات النظام
            </h3>
        </div>
        <div class="card-body">
            <form asp-action="UpdateSettings" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="form-group">
                    <label asp-for="WelcomeTitle" class="form-label">عنوان الترحيب (الصفحة الرئيسية)</label>
                    <input asp-for="WelcomeTitle" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="WelcomeDescription" class="form-label">وصف الترحيب</label>
                    <textarea asp-for="WelcomeDescription" class="form-control" rows="2"></textarea>
                </div>

                <div class="form-group">
                    <label asp-for="AdminWelcome" class="form-label">نص الترحيب (لوحة التحكم)</label>
                    <input asp-for="AdminWelcome" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="AdminDescription" class="form-label">وصف لوحة التحكم</label>
                    <textarea asp-for="AdminDescription" class="form-control" rows="2"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-2"></i>
                    حفظ الإعدادات
                </button>
            </form>
        </div>
    </div>

    <!-- Quick Access -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="bi bi-lightning me-2"></i>
                الوصول السريع
            </h3>
        </div>
        <div class="card-body">
            <div style="display: grid; gap: 1rem;">
                <a href="@Url.Action("Users")" class="stat-card" style="text-decoration: none;">
                    <div class="stat-icon primary">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value" style="font-size: 1rem;">إدارة المستخدمين</div>
                        <div class="stat-label">إضافة وتعديل المستخدمين والصلاحيات</div>
                    </div>
                </a>
                
                <a href="@Url.Action("PermissionsMatrix")" class="stat-card" style="text-decoration: none;">
                    <div class="stat-icon success">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value" style="font-size: 1rem;">إدارة الصلاحيات</div>
                        <div class="stat-label">عرض وتعديل صلاحيات الأدوار</div>
                    </div>
                </a>
                
                <a href="@Url.Action("Index", "Programs")" class="stat-card" style="text-decoration: none;">
                    <div class="stat-icon warning">
                        <i class="bi bi-book"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value" style="font-size: 1rem;">البرامج التدريبية</div>
                        <div class="stat-label">إدارة البرامج والدفعات</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    @@media (max-width: 1024px) {
        div[style*="grid-template-columns: repeat(2, 1fr)"] {
            grid-template-columns: 1fr !important;
        }
    }
</style>
