@model IEnumerable<Registration>
@{
    ViewData["Title"] = "طلبات الترشيح";
    int selectedProgramId = ViewBag.CurrentProgramId is int programId ? programId : 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">طلبات الترشيح</h4>
        <p class="text-muted mb-0">إدارة ومراجعة طلبات الترشيح للبرامج التدريبية</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (selectedProgramId > 0)
        {
            <a asp-controller="Registrations" asp-action="ExportByProgram" asp-route-programId="@selectedProgramId" class="btn btn-success">
                <i class="bi bi-file-earmark-spreadsheet me-2"></i> تصدير جميع الحالات للبرنامج المحدد
            </a>
        }
        else
        {
            <button type="button" class="btn btn-success" disabled title="اختر برنامجاً محدداً أولاً">
                <i class="bi bi-file-earmark-spreadsheet me-2"></i> اختر برنامجاً للتصدير
            </button>
        }
        <a asp-action="Export" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-spreadsheet me-2"></i> تصدير جميع الطلبات Excel
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form asp-controller="Registrations" asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-lg-4 col-md-6">
                <label class="form-label" for="search">البحث</label>
                <input id="search" type="search" name="search" class="form-control" placeholder="الاسم أو الرقم الوظيفي أو المسمى أو البريد..." value="@ViewBag.Search" />
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label" for="programId">البرنامج</label>
                <select id="programId" name="programId" class="form-select">
                    <option value="">جميع البرامج</option>
                    @if (ViewBag.Programs != null)
                    {
                        foreach (var program in ViewBag.Programs)
                        {
                            int currentId = (int)program.Id;
                            if (selectedProgramId == currentId)
                            {
                                <option value="@currentId" selected>@program.Title</option>
                            }
                            else
                            {
                                <option value="@currentId">@program.Title</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label" for="status">الحالة</label>
                <select id="status" name="status" class="form-select">
                    <option value="">جميع الحالات</option>
                    @if (ViewBag.CurrentStatus == "Pending")
                    {
                        <option value="Pending" selected>قيد المراجعة</option>
                    }
                    else
                    {
                        <option value="Pending">قيد المراجعة</option>
                    }
                    @if (ViewBag.CurrentStatus == "Approved")
                    {
                        <option value="Approved" selected>مقبول</option>
                    }
                    else
                    {
                        <option value="Approved">مقبول</option>
                    }
                    @if (ViewBag.CurrentStatus == "Rejected")
                    {
                        <option value="Rejected" selected>مرفوض</option>
                    }
                    else
                    {
                        <option value="Rejected">مرفوض</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-2"></i> بحث وفلترة
                </button>
            </div>
            <div class="col-lg-1 col-md-3">
                <a asp-action="Index" class="btn btn-outline-secondary w-100" title="مسح البحث والفلاتر" aria-label="مسح البحث والفلاتر">
                    <i class="bi bi-x-circle"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted">عدد النتائج: <strong>@ViewBag.FilteredCount</strong></span>
    @if (selectedProgramId > 0)
    {
        <span class="badge bg-primary">تم تطبيق فلتر البرنامج</span>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>الموظف</th>
                            <th>جهة العمل</th>
                            <th>البرنامج / الدفعة</th>
                            <th>التواصل</th>
                            <th>التاريخ</th>
                            <th>الحالة</th>
                            <th style="width: 180px">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reg in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@reg.VisitorName</strong>
                                    <br /><small class="text-muted">@reg.EmployeeId</small>
                                    @if (!string.IsNullOrEmpty(reg.JobTitle))
                                    {
                                        <br /><small class="text-muted">@reg.JobTitle</small>
                                    }
                                </td>
                                <td>
                                    <small>@reg.Court</small>
                                    <br /><small class="text-muted">@reg.Department</small>
                                </td>
                                <td>
                                    <small>@reg.Batch?.TrainingProgram?.Title</small>
                                    <br /><small class="text-muted">@reg.Batch?.Name</small>
                                </td>
                                <td>
                                    <small><i class="bi bi-envelope me-1 text-muted"></i> @reg.Email</small>
                                    <br /><small><i class="bi bi-phone me-1 text-muted"></i> @reg.Phone</small>
                                </td>
                                <td>
                                    <small>@reg.RegisteredAt.ToString("yyyy/MM/dd")</small>
                                    <br /><small class="text-muted">@reg.RegisteredAt.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    @switch (reg.Status)
                                    {
                                        case RegistrationStatus.Pending:
                                            <span class="badge bg-warning">قيد المراجعة</span>
                                            break;
                                        case RegistrationStatus.Approved:
                                            <span class="badge bg-success">مقبول</span>
                                            break;
                                        case RegistrationStatus.Rejected:
                                            <span class="badge bg-danger">مرفوض</span>
                                            break;
                                        case RegistrationStatus.Completed:
                                            <span class="badge bg-info">مكتمل</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        @if (reg.Status == RegistrationStatus.Pending)
                                        {
                                            <form asp-action="Approve" asp-route-id="@reg.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success" title="قبول">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-danger" title="رفض"
                                                    data-bs-toggle="modal" data-bs-target="#rejectModal@(reg.Id)">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        }
                                        <a asp-action="Details" asp-route-id="@reg.Id" class="btn btn-sm btn-outline-primary" title="تفاصيل">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal@(reg.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Reject Modal -->
                                    <div class="modal fade" id="rejectModal@(reg.Id)" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <form asp-action="Reject" asp-route-id="@reg.Id" method="post">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">رفض الطلب</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <label class="form-label">سبب الرفض (اختياري)</label>
                                                            <textarea name="notes" class="form-control" rows="3" placeholder="أدخل سبب الرفض..."></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                                                        <button type="submit" class="btn btn-danger">
                                                            <i class="bi bi-x-lg me-1"></i> رفض الطلب
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Delete Modal -->
                                    <div class="modal fade" id="deleteModal@(reg.Id)" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">تأكيد الحذف</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p>هل أنت متأكد من حذف طلب "<strong>@reg.VisitorName</strong>"؟</p>
                                                    <p class="text-muted small mb-0">لا يمكن التراجع عن هذا الإجراء.</p>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                                                    <form asp-action="Delete" asp-route-id="@reg.Id" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-danger">
                                                            <i class="bi bi-trash me-1"></i> حذف
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="mb-3">
                    <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                </div>
                <h5 class="text-muted">لا توجد طلبات ترشيح</h5>
                <p class="text-muted">سيظهر هنا جميع طلبات الترشيح للبرامج التدريبية</p>
            </div>
        }
    </div>
</div>
