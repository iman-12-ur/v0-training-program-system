@model Registration
@{
    ViewData["Title"] = "تفاصيل الطلب";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-person-badge me-2 text-primary"></i> تفاصيل طلب الترشيح
    </h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-2"></i> رجوع
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent">
                <h5 class="mb-0"><i class="bi bi-person text-primary me-2"></i> معلومات الموظف</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-muted small">الاسم الكامل</label>
                        <p class="fw-bold mb-0">@Model.VisitorName</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">الرقم الوظيفي</label>
                        <p class="fw-bold mb-0">@Model.EmployeeId</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">المسمى الوظيفي</label>
                        <p class="fw-bold mb-0">@Model.JobTitle</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">الدائرة/المحكمة</label>
                        <p class="fw-bold mb-0">@Model.Court</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">القسم</label>
                        <p class="fw-bold mb-0">@Model.Department</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">البريد الإلكتروني</label>
                        <p class="fw-bold mb-0">
                            <a href="mailto:@Model.Email">@Model.Email</a>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">رقم الهاتف</label>
                        <p class="fw-bold mb-0">
                            <a href="tel:@Model.Phone">@Model.Phone</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent">
                <h5 class="mb-0"><i class="bi bi-collection text-primary me-2"></i> معلومات البرنامج</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-muted small">البرنامج التدريبي</label>
                        <p class="fw-bold mb-0">@Model.Batch?.TrainingProgram?.Title</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">الدفعة</label>
                        <p class="fw-bold mb-0">@Model.Batch?.Name</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">تاريخ الدفعة</label>
                        <p class="fw-bold mb-0">
                            @Model.Batch?.StartDate.ToString("yyyy/MM/dd") - @Model.Batch?.EndDate.ToString("yyyy/MM/dd")
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">تاريخ التسجيل</label>
                        <p class="fw-bold mb-0">@Model.RegisteredAt.ToString("yyyy/MM/dd HH:mm")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent">
                <h5 class="mb-0"><i class="bi bi-info-circle text-primary me-2"></i> حالة الطلب</h5>
            </div>
            <div class="card-body text-center">
                @switch (Model.Status)
                {
                    case RegistrationStatus.Pending:
                        <span class="badge bg-warning fs-5 p-3 mb-3">قيد المراجعة</span>
                        break;
                    case RegistrationStatus.Approved:
                        <span class="badge bg-success fs-5 p-3 mb-3">مقبول</span>
                        break;
                    case RegistrationStatus.Rejected:
                        <span class="badge bg-danger fs-5 p-3 mb-3">مرفوض</span>
                        break;
                    case RegistrationStatus.Completed:
                        <span class="badge bg-info fs-5 p-3 mb-3">مكتمل</span>
                        break;
                }

                @if (!string.IsNullOrEmpty(Model.ApprovedBy))
                {
                    <p class="small text-muted mb-1">معتمد من: @Model.ApprovedBy</p>
                    <p class="small text-muted">@Model.ApprovedAt?.ToString("yyyy/MM/dd HH:mm")</p>
                }

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <hr />
                    <p class="small"><strong>ملاحظات:</strong> @Model.Notes</p>
                }
            </div>
        </div>

        @if (Model.Status == RegistrationStatus.Pending)
        {
            <div class="d-grid gap-2">
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-success btn-lg w-100">
                        <i class="bi bi-check-lg me-2"></i> قبول الطلب
                    </button>
                </form>
                <button type="button" class="btn btn-danger btn-lg" data-bs-toggle="modal" data-bs-target="#rejectModal">
                    <i class="bi bi-x-lg me-2"></i> رفض الطلب
                </button>
            </div>

            <!-- Reject Modal -->
            <div class="modal fade" id="rejectModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                            <div class="modal-header">
                                <h5 class="modal-title">رفض الطلب</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <label class="form-label">سبب الرفض (اختياري)</label>
                                <textarea name="notes" class="form-control" rows="3" placeholder="أدخل سبب الرفض..."></textarea>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                                <button type="submit" class="btn btn-danger">رفض الطلب</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
