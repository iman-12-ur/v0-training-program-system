@model List<TrainingSystem.Models.ProgramImportRow>
@{
    ViewData["Title"] = "معاينة استيراد البرامج";
    var validCount = Model.Count(r => r.IsValid);
    var invalidCount = Model.Count - validCount;
}

<!-- Page Header -->
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title">معاينة استيراد البرامج</h1>
        <p class="page-subtitle">راجع البيانات وتحقق منها قبل الاستيراد النهائي</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-secondary">
        <i class="bi bi-arrow-right me-2"></i>
        رجوع
    </a>
</div>

<!-- Summary -->
<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.5rem;">
    <div class="card">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div>
                <p class="text-muted mb-1" style="font-size: 0.875rem;">إجمالي الصفوف</p>
                <h3 class="mb-0">@Model.Count</h3>
            </div>
            <i class="bi bi-list-ul text-primary" style="font-size: 1.75rem;"></i>
        </div>
    </div>
    <div class="card">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div>
                <p class="text-muted mb-1" style="font-size: 0.875rem;">صفوف صالحة</p>
                <h3 class="mb-0 text-success">@validCount</h3>
            </div>
            <i class="bi bi-check-circle text-success" style="font-size: 1.75rem;"></i>
        </div>
    </div>
    <div class="card">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div>
                <p class="text-muted mb-1" style="font-size: 0.875rem;">صفوف بها أخطاء</p>
                <h3 class="mb-0 text-danger">@invalidCount</h3>
            </div>
            <i class="bi bi-exclamation-triangle text-danger" style="font-size: 1.75rem;"></i>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (validCount == 0)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                لا توجد صفوف صالحة للاستيراد. الرجاء تصحيح الأخطاء في الملف وإعادة رفعه.
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                سيتم استيراد <strong>@validCount</strong> برنامج صالح.
                @if (invalidCount > 0)
                {
                    <span>الصفوف التي بها أخطاء (@invalidCount) سيتم تجاهلها.</span>
                }
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>الحالة</th>
                        <th>رمز البرنامج</th>
                        <th>العنوان</th>
                        <th>المدة</th>
                        <th>المدرب</th>
                        <th>الموقع</th>
                        <th>الملاحظات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        <tr class="@(row.IsValid ? "" : "table-danger")">
                            <td>@row.RowNumber</td>
                            <td>
                                @if (row.IsValid)
                                {
                                    <span class="badge bg-success">صالح</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">خطأ</span>
                                }
                            </td>
                            <td>@row.ProgramCode</td>
                            <td>@row.Title</td>
                            <td>@row.Duration</td>
                            <td>@row.Instructor</td>
                            <td>@row.Location</td>
                            <td>
                                @if (row.Errors.Any())
                                {
                                    <small class="text-danger">@string.Join("، ", row.Errors)</small>
                                }
                                else
                                {
                                    <small class="text-success">جاهز للاستيراد</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <form asp-action="ImportConfirm" method="post" style="border-top: 1px solid var(--border); padding-top: 1.5rem; margin-top: 1rem; display: flex; gap: 0.75rem;">
            @{ var idx = 0; }
            @foreach (var row in Model.Where(r => r.IsValid))
            {
                <input type="hidden" name="rows[@idx].RowNumber" value="@row.RowNumber" />
                <input type="hidden" name="rows[@idx].ProgramCode" value="@row.ProgramCode" />
                <input type="hidden" name="rows[@idx].Title" value="@row.Title" />
                <input type="hidden" name="rows[@idx].Description" value="@row.Description" />
                <input type="hidden" name="rows[@idx].Categories" value="@row.Categories" />
                <input type="hidden" name="rows[@idx].ProgramType" value="@row.ProgramType" />
                <input type="hidden" name="rows[@idx].TargetAudience" value="@row.TargetAudience" />
                <input type="hidden" name="rows[@idx].Duration" value="@row.Duration" />
                <input type="hidden" name="rows[@idx].Instructor" value="@row.Instructor" />
                <input type="hidden" name="rows[@idx].Location" value="@row.Location" />
                <input type="hidden" name="rows[@idx].Objectives" value="@row.Objectives" />
                <input type="hidden" name="rows[@idx].Topics" value="@row.Topics" />
                <input type="hidden" name="rows[@idx].Prerequisites" value="@row.Prerequisites" />
                idx++;
            }
            <button type="submit" class="btn btn-primary btn-lg" @(validCount == 0 ? "disabled" : "")>
                <i class="bi bi-check-lg me-2"></i>
                تأكيد واستيراد @validCount برنامج
            </button>
            <a href="@Url.Action("Create")" class="btn btn-secondary btn-lg">
                <i class="bi bi-x-lg me-2"></i>
                إلغاء
            </a>
        </form>
    </div>
</div>
