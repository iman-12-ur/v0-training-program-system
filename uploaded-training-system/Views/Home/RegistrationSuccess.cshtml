@{
    ViewData["Title"] = "تم التسجيل بنجاح";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card border-0 shadow">
            <div class="card-body p-5">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                </div>
                <h2 class="fw-bold text-success mb-3">تم التسجيل بنجاح!</h2>
                <p class="text-muted mb-4">
                    تم استلام طلب ترشيحك بنجاح. سيتم مراجعة الطلب من قبل الإدارة وسيتم إبلاغك بالنتيجة قريباً.
                </p>
                <a asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="bi bi-arrow-right me-2"></i> العودة للبرامج التدريبية
                </a>
            </div>
        </div>
    </div>
</div>
