@model List<TrainingSystem.Models.Registration>
@{
    ViewData["Title"] = "تقرير التسجيلات";
    var programs = ViewBag.Programs as List<TrainingSystem.Models.TrainingProgram>;
    var selectedStatus = ViewBag.SelectedStatus as string ?? "all";
    var selectedProgramId = ViewBag.SelectedProgramId as int?;
}

<div class="page-header">
    <div>
        <h1 class="page-title">تقرير التسجيلات</h1>
        <p class="text-muted mb-0">عرض وتصفية جميع طلبات الترشيح</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right me-2"></i>العودة
        </a>
        <a asp-controller="Reports"
           asp-action="ExportToExcel"
           asp-route-type="registrations"
           asp-route-status="@selectedStatus"
           asp-route-programId="@selectedProgramId"
           class="btn btn-primary">
            <i class="bi bi-file-earmark-spreadsheet me-2"></i>تصدير النتائج الحالية Excel
        </a>
    </div>
</div>

<!-- فلاتر البحث -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">الحالة</label>
                <select name="status" class="form-select">
                    <option value="all" selected="@(selectedStatus == "all")">جميع الحالات</option>
                    <option value="Pending" selected="@(selectedStatus == "Pending")">قيد المراجعة</option>
                    <option value="Approved" selected="@(selectedStatus == "Approved")">مقبول</option>
                    <option value="Rejected" selected="@(selectedStatus == "Rejected")">مرفوض</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">البرنامج التدريبي</label>
                <select name="programId" class="form-select">
                    <option value="">جميع البرامج</option>
                    @if (programs != null)
                    {
                        @foreach (var program in programs)
                        {
                            <option value="@program.Id" selected="@(selectedProgramId == program.Id)">@program.Title</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-2"></i>بحث
                </button>
            </div>
        </form>
    </div>
</div>

<!-- نتائج -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">النتائج (@Model.Count تسجيل)</h5>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>الاسم</th>
                            <th>الرقم الوظيفي</th>
                            <th>البريد الإلكتروني</th>
                            <th>الهاتف</th>
                            <th>البرنامج</th>
                            <th>الدفعة</th>
                            <th>تاريخ التسجيل</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var index = 1;
                        }
                        @foreach (var reg in Model)
                        {
                            <tr>
                                <td>@(index++)</td>
                                <td><strong>@reg.VisitorName</strong></td>
                                <td>@reg.EmployeeId</td>
                                <td>@reg.Email</td>
                                <td>@reg.Phone</td>
                                <td>@reg.Batch?.TrainingProgram?.Title</td>
                                <td>@reg.Batch?.Name</td>
                                <td>@reg.RegisteredAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>
                                    @{
                                        var statusClass = reg.Status switch
                                        {
                                            TrainingSystem.Models.RegistrationStatus.Approved => "success",
                                            TrainingSystem.Models.RegistrationStatus.Rejected => "danger",
                                            _ => "warning"
                                        };
                                        var statusText = reg.Status switch
                                        {
                                            TrainingSystem.Models.RegistrationStatus.Approved => "مقبول",
                                            TrainingSystem.Models.RegistrationStatus.Rejected => "مرفوض",
                                            _ => "قيد المراجعة"
                                        };
                                    }
                                    <span class="badge bg-@statusClass">@statusText</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <h5 class="mt-3 text-muted">لا توجد نتائج</h5>
                <p class="text-muted">جرب تغيير معايير البحث</p>
            </div>
        }
    </div>
</div>
