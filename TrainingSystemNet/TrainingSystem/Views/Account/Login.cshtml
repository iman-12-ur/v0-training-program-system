@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول - المجلس الأعلى للقضاء</title>
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="login-container">
        <div class="login-card animate-slideIn">
            <!-- Header -->
            <div class="login-header">
                <div class="login-logo">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <h1>نظام إدارة البرامج التدريبية</h1>
                <p>المجلس الأعلى للقضاء - دائرة التدريب والتأهيل</p>
            </div>

            <!-- Body -->
            <div class="login-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <form method="post">
                    <div class="form-group">
                        <label class="form-label">اسم المستخدم</label>
                        <div style="position: relative;">
                            <input type="text" name="username" class="form-control" placeholder="أدخل اسم المستخدم" required style="padding-right: 2.5rem;" />
                            <i class="bi bi-person" style="position: absolute; right: 0.875rem; top: 50%; transform: translateY(-50%); color: var(--muted-foreground);"></i>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">كلمة المرور</label>
                        <div style="position: relative;">
                            <input type="password" name="password" class="form-control" placeholder="أدخل كلمة المرور" required style="padding-right: 2.5rem;" />
                            <i class="bi bi-lock" style="position: absolute; right: 0.875rem; top: 50%; transform: translateY(-50%); color: var(--muted-foreground);"></i>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-lg mb-3">
                        <i class="bi bi-box-arrow-in-left me-2"></i>
                        دخول
                    </button>

                    <div class="text-center">
                        <a href="@Url.Action("Index", "Home")" style="color: var(--primary); text-decoration: none;">
                            <i class="bi bi-arrow-right me-1"></i>
                            العودة للصفحة الرئيسية
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="text-center mt-4" style="color: var(--muted-foreground);">
            <small>بيانات الدخول الافتراضية: admin / Admin@123</small>
        </div>
    </div>
</body>
</html>
