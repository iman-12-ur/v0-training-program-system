@{
    ViewData["Title"] = "غير مصرح لك";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام التدريب</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .access-denied-card {
            background: white;
            border-radius: 20px;
            padding: 3rem;
            text-align: center;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            max-width: 500px;
        }
        .icon-circle {
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 2rem;
        }
        .icon-circle i {
            font-size: 3.5rem;
            color: white;
        }
        h1 {
            color: #333;
            font-weight: 700;
            margin-bottom: 1rem;
        }
        .message {
            color: #666;
            font-size: 1.1rem;
            margin-bottom: 2rem;
            line-height: 1.8;
        }
        .btn-back {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1rem;
            border-radius: 10px;
            color: white;
            text-decoration: none;
            display: inline-block;
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .btn-back:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);
            color: white;
        }
        .btn-home {
            background: #6c757d;
            border: none;
            padding: 12px 30px;
            font-size: 1rem;
            border-radius: 10px;
            color: white;
            text-decoration: none;
            display: inline-block;
            transition: transform 0.3s, box-shadow 0.3s;
            margin-right: 10px;
        }
        .btn-home:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(108, 117, 125, 0.4);
            color: white;
        }
    </style>
</head>
<body>
    <div class="access-denied-card">
        <div class="icon-circle">
            <i class="bi bi-shield-lock"></i>
        </div>
        <h1>عذراً، لا يمكنك الوصول</h1>
        <p class="message">
            ليس لديك الصلاحية الكافية للوصول إلى هذه الصفحة.
            <br>
            يرجى التواصل مع مدير النظام إذا كنت تعتقد أن هذا خطأ.
        </p>
        <div>
            <a href="/" class="btn-home">
                <i class="bi bi-house-door me-2"></i>
                الصفحة الرئيسية
            </a>
            <a href="javascript:history.back()" class="btn-back">
                <i class="bi bi-arrow-right me-2"></i>
                العودة للخلف
            </a>
        </div>
    </div>
</body>
</html>
