@model List<TrainingSystem.Models.Notification>
@using TrainingSystem.Models
@{
    ViewData["Title"] = "الإشعارات";
    var unread = Model.Count(n => !n.IsRead);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">الإشعارات</h4>
        <p class="text-muted mb-0">تنبيهات سير عمل الاحتياجات التدريبية الخاصة بك</p>
    </div>
    @if (unread > 0)
    {
        <form method="post" asp-action="MarkAllRead">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-check2-all me-1"></i> تعليم الكل كمقروء (@unread)
            </button>
        </form>
    }
</div>

@if (!Model.Any())
{
    <div class="card"><div class="card-body text-center text-muted py-5">
        <i class="bi bi-bell-slash fs-1 d-block mb-2"></i>
        لا توجد إشعارات حالياً
    </div></div>
}
else
{
    <div class="card">
        <div class="list-group list-group-flush">
            @foreach (var n in Model)
            {
                <a href="@Url.Action("Open", "Notifications", new { id = n.Id })"
                   class="list-group-item list-group-item-action d-flex align-items-start gap-3 @(n.IsRead ? "" : "bg-light")">
                    <i class="bi @Notification.GetIcon(n.Type) text-@Notification.GetColor(n.Type) fs-5 mt-1"></i>
                    <div class="flex-grow-1">
                        <div class="@(n.IsRead ? "" : "fw-semibold")">@n.Message</div>
                        <div class="small text-muted">@n.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                    </div>
                    @if (!n.IsRead)
                    {
                        <span class="badge bg-primary rounded-pill">جديد</span>
                    }
                </a>
            }
        </div>
    </div>
}
