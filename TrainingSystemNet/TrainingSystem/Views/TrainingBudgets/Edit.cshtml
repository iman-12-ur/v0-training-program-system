@model TrainingSystem.Models.TrainingBudget
@{
    ViewData["Title"] = "تعديل الميزانية";
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">تعديل الموازنة المركزية</h4>
    <p class="text-muted mb-0">السنة المالية @Model.FinancialYear</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small mb-1">الملتزم به</div>
            <div class="fs-5 fw-bold text-warning">@Model.CommittedBudget.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small mb-1">المصروف الفعلي</div>
            <div class="fs-5 fw-bold text-info">@Model.ActualSpending.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small mb-1">المتبقي</div>
            <div class="fs-5 fw-bold @(Model.RemainingBudget < 0 ? "text-danger" : "text-success")">@Model.RemainingBudget.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small mb-1">الاستهلاك</div>
            <div class="fs-5 fw-bold">@Model.UtilizationPercent%</div>
        </div></div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FinancialYear" />
            <div asp-validation-summary="All" class="text-danger small"></div>

            <div class="col-md-6">
                <label class="form-label">الميزانية المخصصة</label>
                <input asp-for="AllocatedBudget" type="number" step="0.01" min="0" class="form-control" />
                <div class="form-text">الملتزم به والمصروف الفعلي يُحتسبان تلقائياً من سير عمل الاحتياجات.</div>
            </div>

            <div class="col-12 d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i> حفظ
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>
