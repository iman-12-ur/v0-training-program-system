@model TrainingSystem.Models.TrainingBudget
@{
    ViewData["Title"] = "تعريف الموازنة المركزية";
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">تعريف الموازنة المركزية لدائرة التدريب</h4>
    <p class="text-muted mb-0">وعاء واحد للسنة المالية</p>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger small"></div>

            <div class="col-md-6">
                <label class="form-label">السنة المالية</label>
                <input asp-for="FinancialYear" class="form-control" placeholder="2025/2026" />
            </div>

            <div class="col-md-6">
                <label class="form-label">الميزانية المخصصة</label>
                <input asp-for="AllocatedBudget" type="number" step="0.01" min="0" class="form-control" />
            </div>

            <div class="col-12 d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i> حفظ
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>
