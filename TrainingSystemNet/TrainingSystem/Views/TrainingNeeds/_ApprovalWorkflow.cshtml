@model TrainingSystem.Models.TrainingNeed
@using TrainingSystem.Models
@{
    var stages = Model.GetWorkflowStages();
    var doneCount = stages.Count(s => s.State == WorkflowStageState.Completed);
    var pct = (int)System.Math.Round(100.0 * doneCount / stages.Count);
}

<div class="card mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0">دورة الاعتماد</h6>
        <span class="small text-muted">@doneCount / @stages.Count مرحلة مكتملة</span>
    </div>
    <div class="card-body">
        <div class="progress mb-3" style="height: 6px;">
            <div class="progress-bar bg-success" role="progressbar" style="width: @pct%"
                 aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
        </div>

        <ol class="list-unstyled mb-0 workflow-timeline">
            @foreach (var s in stages)
            {
                <li class="d-flex gap-3 pb-3">
                    <div class="text-center" style="width: 2rem;">
                        <span class="badge rounded-circle bg-@s.BadgeClass d-inline-flex align-items-center justify-content-center"
                              style="width: 2rem; height: 2rem;">
                            @if (!string.IsNullOrEmpty(s.Icon))
                            {
                                <i class="bi @s.Icon"></i>
                            }
                            else
                            {
                                @s.Number
                            }
                        </span>
                    </div>
                    <div class="flex-grow-1 @(s.State == WorkflowStageState.Pending ? "text-muted" : "")">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <span class="@(s.State == WorkflowStageState.Current ? "fw-bold" : "fw-semibold")">
                                @s.Number. @s.Title
                            </span>
                            <span class="badge bg-@s.BadgeClass-subtle text-@s.BadgeClass small">@s.StateLabel</span>
                        </div>
                        <div class="small text-muted">@s.Actor</div>
                    </div>
                </li>
            }
        </ol>
    </div>
</div>
