@model TrainingSystem.Controllers.TrainingNeedFormViewModel
@{
    ViewData["Title"] = "إضافة احتياج تدريبي";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">إضافة احتياج تدريبي</h4>
        <p class="text-muted mb-0">سجّل احتياجاً تدريبياً لموظف في مهارة محددة</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-right me-2"></i> رجوع
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">اختر موظفاً من النظام (اختياري)</label>
                    <select asp-for="EmployeeUserId" class="form-select" id="employeeSelect"
                            asp-items="Model.Employees">
                        <option value="">— إدخال يدوي —</option>
                    </select>
                    <small class="text-muted">عند الاختيار تُملأ بيانات الموظف تلقائياً.</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label">اسم الموظف <span class="text-danger">*</span></label>
                    <input asp-for="EmployeeName" class="form-control" id="employeeName" />
                    <span asp-validation-for="EmployeeName" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">الرقم الوظيفي</label>
                    <input asp-for="EmployeeNumber" class="form-control" id="employeeNumber" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">الدائرة <span class="text-danger">*</span></label>
                    @if (!Model.IsPrivileged)
                    {
                        <input class="form-control" value="@Model.LockedDepartment" readonly />
                        <input type="hidden" asp-for="Department" value="@Model.LockedDepartment" />
                        <small class="text-muted">مقيّدة بدائرتك.</small>
                    }
                    else
                    {
                        <input asp-for="Department" class="form-control" id="department" />
                        <span asp-validation-for="Department" class="text-danger"></span>
                    }
                </div>

                <div class="col-md-6">
                    <label class="form-label">المسمى الوظيفي</label>
                    <input asp-for="JobTitle" class="form-control" id="jobTitle" placeholder="مثال: محلل نظم" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">الدرجة الوظيفية</label>
                    <input asp-for="Grade" class="form-control" id="grade" placeholder="مثال: الرابعة" />
                </div>

                @if (Model.Skills.Any())
                {
                    <div class="col-md-6">
                        <label class="form-label">اختر مهارة من المكتبة (اختياري)</label>
                        <select asp-for="SkillId" class="form-select" asp-items="Model.Skills">
                            <option value="">— إدخال يدوي —</option>
                        </select>
                        <small class="text-muted">عند الاختيار يُملأ اسم المهارة وتصنيفها.</small>
                    </div>
                }
                <div class="col-md-6">
                    <label class="form-label">المهارة <span class="text-danger">*</span></label>
                    <input asp-for="SkillName" class="form-control" placeholder="مثال: إدارة المشاريع" />
                    <span asp-validation-for="SkillName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">التصنيف</label>
                    <input asp-for="Category" class="form-control" placeholder="تقنية / سلوكية / قيادية" list="categoryList" />
                    <datalist id="categoryList">
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Text"></option>
                        }
                    </datalist>
                </div>

                <div class="col-md-6">
                    <label class="form-label">المستوى المطلوب <span class="text-danger">*</span></label>
                    <select asp-for="RequiredLevel" class="form-select">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                    <span asp-validation-for="RequiredLevel" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">المستوى الحالي <span class="text-danger">*</span></label>
                    <select asp-for="CurrentLevel" class="form-select">
                        @for (int i = 0; i <= 5; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                    <span asp-validation-for="CurrentLevel" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">الفترة الزمنية المقترحة</label>
                    <input asp-for="SuggestedTimeframe" class="form-control" placeholder="مثال: الربع الثاني 2026" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">مبرر الاحتياج</label>
                    <input asp-for="Justification" class="form-control" placeholder="سبب الحاجة للتدريب" />
                </div>

                <div class="col-12"><hr class="my-1" /><div class="fw-semibold text-muted small">التكلفة والأثر والميزانية</div></div>

                @if (Model.Programs.Any())
                {
                    <div class="col-md-6">
                        <label class="form-label">ربط ببرنامج تدريبي</label>
                        <select asp-for="LinkedTrainingProgramId" class="form-select" asp-items="Model.Programs">
                            <option value="">— بدون ربط —</option>
                        </select>
                    </div>
                }
                <div class="col-md-6">
                    <label class="form-label">التكلفة التقديرية</label>
                    <input asp-for="EstimatedCost" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">عدد المشاركين</label>
                    <input asp-for="ParticipantsCount" type="number" min="1" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">الأثر على العمل (1-4)</label>
                    <select asp-for="ImpactScore" class="form-select">
                        @for (int i = 1; i <= 4; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">درجة المخاطر (1-4)</label>
                    <select asp-for="RiskScore" class="form-select">
                        @for (int i = 1; i <= 4; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsCompliance" class="form-check-input" type="checkbox" id="isCompliance" />
                        <label class="form-check-label" for="isCompliance">احتياج امتثال إلزامي (يرفع الأولوية)</label>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label">ملاحظات</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="SubmitForApproval" class="form-check-input" type="checkbox" id="submitForApproval" />
                        <label class="form-check-label" for="submitForApproval">
                            إرسال للاعتماد فور الحفظ (بدلاً من حفظه كمسودة)
                        </label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-2"></i> حفظ
                </button>
                <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ملء بيانات الموظف تلقائياً عند الاختيار من القائمة
        (function () {
            var select = document.getElementById('employeeSelect');
            if (!select) return;
            select.addEventListener('change', function () {
                var text = this.options[this.selectedIndex].text;
                var nameField = document.getElementById('employeeName');
                if (this.value && text.indexOf('—') !== -1) {
                    nameField.value = text.split('—')[0].trim();
                } else if (this.value) {
                    nameField.value = text.trim();
                }
            });
        })();
    </script>
}
