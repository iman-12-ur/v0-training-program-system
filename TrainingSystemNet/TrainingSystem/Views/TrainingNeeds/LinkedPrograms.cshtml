@model List<TrainingSystem.Models.TrainingNeed>
@using TrainingSystem.Models
@{
    ViewData["Title"] = "البرامج التدريبية المرتبطة بالاحتياجات";
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    var currentDept = ViewBag.CurrentDepartment as string;
    var isPrivileged = (bool)(ViewBag.IsPrivileged ?? false);
    var groups = Model
        .GroupBy(n => new { n.LinkedTrainingProgramId, Title = n.LinkedTrainingProgram?.Title })
        .OrderBy(g => g.Key.Title)
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">البرامج التدريبية المرتبطة بالاحتياجات</h4>
        <p class="text-muted mb-0">الاحتياجات التدريبية المربوطة ببرامج قائمة ودفعاتها التدريبية</p>
    </div>
    @if (isPrivileged)
    {
        <form method="get">
            <select name="department" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">كل الدوائر</option>
                @foreach (var d in departments)
                {
                    <option value="@d" selected="@(d == currentDept)">@d</option>
                }
            </select>
        </form>
    }
</div>

@if (!Model.Any())
{
    <div class="card"><div class="card-body text-center text-muted py-5">
        <i class="bi bi-diagram-3 fs-1 d-block mb-2"></i>
        لا توجد احتياجات مرتبطة ببرامج تدريبية حتى الآن
    </div></div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var g in groups)
        {
            <div class="card">
                <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h6 class="fw-bold mb-0">
                        <i class="bi bi-mortarboard me-1"></i>
                        @(g.Key.Title ?? "بدون برنامج")
                    </h6>
                    <span class="badge bg-primary">@g.Count() احتياج مرتبط</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>الموظف</th>
                                <th>المهارة</th>
                                <th>الدائرة</th>
                                <th class="text-center">الفجوة</th>
                                <th>الدفعة التدريبية</th>
                                <th class="text-center">التاريخ المخطّط</th>
                                <th class="text-center">الحالة</th>
                                <th class="text-center">تفاصيل</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var n in g.OrderByDescending(x => x.Gap))
                            {
                                <tr>
                                    <td class="fw-semibold">@n.EmployeeName</td>
                                    <td>@n.SkillName</td>
                                    <td>@n.Department</td>
                                    <td class="text-center"><span class="badge bg-danger">@n.Gap</span></td>
                                    <td>@(n.TrainingBatch != null ? n.TrainingBatch.Name : "—")</td>
                                    <td class="text-center">@(n.PlannedDate?.ToString("yyyy/MM/dd") ?? "—")</td>
                                    <td class="text-center">
                                        <span class="badge bg-@TrainingNeed.GetApprovalStatusBadge(n.ApprovalStatus)">
                                            @TrainingNeed.GetApprovalStatusDisplayName(n.ApprovalStatus)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@n.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
}
