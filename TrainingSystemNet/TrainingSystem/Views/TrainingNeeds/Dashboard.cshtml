@model TrainingSystem.Controllers.TnaDashboardViewModel
@{
    ViewData["Title"] = "لوحة مؤشرات الاحتياجات التدريبية";
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    var currentDept = ViewBag.CurrentDepartment as string;
    int maxGap = Model.GapByDepartment.Any() ? (int)Math.Ceiling(Model.GapByDepartment.Max(d => d.AverageGap)) : 5;
    if (maxGap < 1) maxGap = 1;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">لوحة مؤشرات الاحتياجات التدريبية</h4>
        <p class="text-muted mb-0">نظرة عامة على فجوات المهارات وحالة الاعتمادات</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.IsPrivileged)
        {
            <form method="get" class="d-flex gap-2">
                <select name="department" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">كل الدوائر</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d" selected="@(d == currentDept)">@d</option>
                    }
                </select>
            </form>
        }
        <a asp-action="Reports" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-file-earmark-bar-graph me-1"></i> التقارير
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small">إجمالي الاحتياجات</div>
                    <div class="fs-3 fw-bold">@Model.TotalNeeds</div>
                </div>
                <span class="badge bg-primary-subtle text-primary fs-5"><i class="bi bi-clipboard-data"></i></span>
            </div>
        </div></div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small">عدد الموظفين</div>
                    <div class="fs-3 fw-bold">@Model.EmployeeCount</div>
                </div>
                <span class="badge bg-info-subtle text-info fs-5"><i class="bi bi-people"></i></span>
            </div>
        </div></div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small">أولوية عالية</div>
                    <div class="fs-3 fw-bold text-danger">@Model.HighPriorityCount</div>
                </div>
                <span class="badge bg-danger-subtle text-danger fs-5"><i class="bi bi-exclamation-triangle"></i></span>
            </div>
        </div></div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small">بانتظار الاعتماد</div>
                    <div class="fs-3 fw-bold text-warning">@Model.PendingApprovals</div>
                </div>
                <span class="badge bg-warning-subtle text-warning fs-5"><i class="bi bi-hourglass-split"></i></span>
            </div>
        </div></div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card h-100"><div class="card-body text-center">
            <div class="text-muted small mb-2">نسبة الجاهزية العامة</div>
            <div class="position-relative d-inline-block my-2">
                <div class="fs-1 fw-bold text-primary">@Model.Readiness%</div>
            </div>
            <div class="progress" style="height: 10px;">
                <div class="progress-bar bg-primary" role="progressbar" style="width: @Model.Readiness%"
                     aria-valuenow="@Model.Readiness" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            <div class="mt-3 d-flex justify-content-around">
                <div><div class="fw-bold text-success">@Model.ApprovedCount</div><div class="small text-muted">معتمد</div></div>
                <div><div class="fw-bold text-warning">@Model.PendingApprovals</div><div class="small text-muted">معلّق</div></div>
            </div>
        </div></div>
    </div>

    <div class="col-lg-8">
        <div class="card h-100"><div class="card-body">
            <h6 class="fw-bold mb-3">متوسط الفجوة حسب الدائرة</h6>
            @if (!Model.GapByDepartment.Any())
            {
                <p class="text-muted mb-0">لا توجد بيانات.</p>
            }
            else
            {
                foreach (var d in Model.GapByDepartment)
                {
                    var pct = (int)Math.Round(100.0 * d.AverageGap / maxGap);
                    var barColor = d.AverageGap >= 3 ? "bg-danger" : d.AverageGap >= 2 ? "bg-warning" : "bg-success";
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>@d.Department</span>
                            <span class="fw-bold">@d.AverageGap</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar @barColor" style="width: @pct%"></div>
                        </div>
                    </div>
                }
            }
        </div></div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h6 class="fw-bold mb-3">توزيع الأولويات</h6>
            @{
                var totalPr = Model.PriorityDistribution.Values.Sum();
            }
            @foreach (var kv in Model.PriorityDistribution)
            {
                var pct = totalPr > 0 ? (int)Math.Round(100.0 * kv.Value / totalPr) : 0;
                var col = kv.Key == "حرجة جداً" ? "bg-dark" : kv.Key == "عالية" ? "bg-danger" : kv.Key == "متوسطة" ? "bg-warning" : "bg-success";
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>@kv.Key</span>
                        <span class="fw-bold">@kv.Value (@pct%)</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar @col" style="width: @pct%"></div>
                    </div>
                </div>
            }
        </div></div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h6 class="fw-bold mb-3">التصنيفات الأكثر طلباً</h6>
            @if (!Model.CategoryDistribution.Any())
            {
                <p class="text-muted mb-0">لا توجد تصنيفات مسجّلة.</p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var kv in Model.CategoryDistribution.OrderByDescending(x => x.Value))
                    {
                        <span class="badge bg-light text-dark border py-2 px-3">@kv.Key <span class="badge bg-primary ms-1">@kv.Value</span></span>
                    }
                </div>
            }
        </div></div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0">أحدث الاحتياجات المسجّلة</h6>
        <a asp-action="Index" class="btn btn-sm btn-link">عرض الكل</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>الموظف</th>
                    <th>الدائرة</th>
                    <th>المهارة</th>
                    <th class="text-center">الفجوة</th>
                    <th class="text-center">الأولوية</th>
                    <th class="text-center">الاعتماد</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.RecentNeeds.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">لا توجد بيانات</td></tr>
                }
                @foreach (var n in Model.RecentNeeds)
                {
                            var prBadge = TrainingSystem.Models.TrainingNeed.GetPriorityBadge(n.Priority);
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@n.Id" class="text-decoration-none">@n.EmployeeName</a></td>
                        <td>@n.Department</td>
                        <td>@n.SkillName</td>
                        <td class="text-center"><span class="badge bg-secondary">@n.Gap</span></td>
                        <td class="text-center"><span class="badge bg-@prBadge">@TrainingSystem.Models.TrainingNeed.GetPriorityDisplayName(n.Priority)</span></td>
                        <td class="text-center"><span class="badge bg-@TrainingSystem.Models.TrainingNeed.GetApprovalStatusBadge(n.ApprovalStatus)">@TrainingSystem.Models.TrainingNeed.GetApprovalStatusDisplayName(n.ApprovalStatus)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
