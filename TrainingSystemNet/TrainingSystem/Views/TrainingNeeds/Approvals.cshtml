@model List<TrainingSystem.Models.TrainingNeed>
@using TrainingSystem.Models
@{
    ViewData["Title"] = "الاعتمادات المعلّقة";
    var managerQueue = Model.Where(n => n.ApprovalStatus == TrainingNeedApprovalStatus.SubmittedToManager).ToList();
    var hrQueue = Model.Where(n => n.ApprovalStatus == TrainingNeedApprovalStatus.ManagerApproved).ToList();
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">الاعتمادات المعلّقة</h4>
    <p class="text-muted mb-0">الاحتياجات التدريبية بانتظار اتخاذ إجراء</p>
</div>

<div class="card mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0"><i class="bi bi-person-badge me-1"></i> بانتظار المدير المباشر</h6>
        <span class="badge bg-info">@managerQueue.Count</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>الموظف</th><th>الدائرة</th><th>المهارة</th><th class="text-center">الفجوة</th><th class="text-center">الأولوية</th><th>تاريخ الإرسال</th><th></th></tr>
            </thead>
            <tbody>
                @if (!managerQueue.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">لا توجد طلبات بانتظار المدير</td></tr>
                }
                @foreach (var n in managerQueue)
                {
                        var prBadge = TrainingNeed.GetPriorityBadge(n.Priority);
                    <tr>
                        <td>@n.EmployeeName</td>
                        <td>@n.Department</td>
                        <td>@n.SkillName</td>
                        <td class="text-center"><span class="badge bg-secondary">@n.Gap</span></td>
                        <td class="text-center"><span class="badge bg-@prBadge">@TrainingNeed.GetPriorityDisplayName(n.Priority)</span></td>
                        <td>@(n.SubmittedAt?.ToString("yyyy/MM/dd") ?? "—")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@n.Id" class="btn btn-sm btn-primary">مراجعة</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0"><i class="bi bi-building me-1"></i> بانتظار الموارد البشرية</h6>
        <span class="badge bg-primary">@hrQueue.Count</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>الموظف</th><th>الدائرة</th><th>المهارة</th><th class="text-center">الفجوة</th><th class="text-center">الأولوية</th><th>اعتماد المدير</th><th></th></tr>
            </thead>
            <tbody>
                @if (!hrQueue.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">لا توجد طلبات بانتظار الموارد البشرية</td></tr>
                }
                @foreach (var n in hrQueue)
                {
                        var prBadge = TrainingNeed.GetPriorityBadge(n.Priority);
                    <tr>
                        <td>@n.EmployeeName</td>
                        <td>@n.Department</td>
                        <td>@n.SkillName</td>
                        <td class="text-center"><span class="badge bg-secondary">@n.Gap</span></td>
                        <td class="text-center"><span class="badge bg-@prBadge">@TrainingNeed.GetPriorityDisplayName(n.Priority)</span></td>
                        <td>@(n.ManagerActionAt?.ToString("yyyy/MM/dd") ?? "—")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@n.Id" class="btn btn-sm btn-primary">مراجعة</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
