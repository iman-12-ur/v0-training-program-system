@model TrainingSystem.Controllers.TrainingNeedsIndexViewModel
@using TrainingSystem.Models
@{
    ViewData["Title"] = "الاحتياجات التدريبية";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">الاحتياجات التدريبية</h4>
        <p class="text-muted mb-0">
            @if (Model.IsPrivileged)
            {
                <span>إدارة الاحتياجات التدريبية لجميع الدوائر</span>
            }
            else
            {
                <span>احتياجات دائرة: <strong>@(Model.CurrentDepartment ?? "غير محددة")</strong></span>
            }
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="DownloadTemplate" class="btn btn-outline-success">
            <i class="bi bi-download me-2"></i> قالب Excel
        </a>
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#importModal">
            <i class="bi bi-file-earmark-arrow-up me-2"></i> رفع ملف Excel
        </button>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i> إضافة احتياج
        </a>
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <p class="text-muted mb-1 small">إجمالي الاحتياجات</p>
                    <h3 class="mb-0">@Model.TotalNeeds</h3>
                </div>
                <i class="bi bi-list-check text-primary fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <p class="text-muted mb-1 small">عدد الموظفين</p>
                    <h3 class="mb-0">@Model.EmployeeCount</h3>
                </div>
                <i class="bi bi-people text-info fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <p class="text-muted mb-1 small">أولوية عالية</p>
                    <h3 class="mb-0 text-danger">@Model.HighPriorityCount</h3>
                </div>
                <i class="bi bi-exclamation-triangle text-danger fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <p class="text-muted mb-1 small">نسبة الجاهزية</p>
                    <h3 class="mb-0 text-success">@Model.Readiness%</h3>
                </div>
                <i class="bi bi-speedometer2 text-success fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- How it works -->
<div class="card mb-4 bg-light border-0">
    <div class="card-body">
        <h6 class="fw-bold mb-3">كيف تعمل الاحتياجات التدريبية؟</h6>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="d-flex gap-2">
                    <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width:2rem;height:2rem;">1</span>
                    <div>
                        <div class="fw-semibold">تحديد الفجوة</div>
                        <small class="text-muted">قارن المستوى المطلوب للمهارة بالمستوى الحالي للموظف. الفارق = الفجوة.</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex gap-2">
                    <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width:2rem;height:2rem;">2</span>
                    <div>
                        <div class="fw-semibold">ترتيب الأولوية</div>
                        <small class="text-muted">يحسب النظام الأولوية تلقائياً: فجوة 3+ عالية، 2 متوسطة، 1 منخفضة.</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex gap-2">
                    <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width:2rem;height:2rem;">3</span>
                    <div>
                        <div class="fw-semibold">ربط ببرنامج</div>
                        <small class="text-muted">يقترح النظام برنامجاً تدريبياً من البرامج المتاحة لسدّ كل فجوة.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.GapByDepartment.Any())
{
    <div class="card mb-4">
        <div class="card-header bg-white">
            <i class="bi bi-graph-up-arrow text-primary me-1"></i>
            متوسط الفجوة حسب الدائرة
        </div>
        <div class="card-body">
            @foreach (var d in Model.GapByDepartment)
            {
                var pct = (int)Math.Round(d.AverageGap / 5.0 * 100);
                var barClass = d.AverageGap >= 3 ? "bg-danger" : d.AverageGap >= 2 ? "bg-warning" : "bg-success";
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small fw-semibold">@d.Department</span>
                        <span class="small text-muted">متوسط الفجوة: @d.AverageGap</span>
                    </div>
                    <div class="progress" style="height: 10px;">
                        <div class="progress-bar @barClass" role="progressbar" style="width: @pct%"
                             aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label">البحث</label>
                <input type="text" name="search" class="form-control" placeholder="اسم الموظف أو الرقم الوظيفي أو المهارة..." value="@Model.Search" />
            </div>
            @if (Model.IsPrivileged)
            {
                <div class="col-md-4">
                    <label class="form-label">الدائرة</label>
                    <select name="department" class="form-select">
                        <option value="">جميع الدوائر</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept" selected="@(Model.CurrentDepartment == dept ? "selected" : null)">@dept</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-2"></i> بحث
                </button>
            </div>
            <div class="col-md-1">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-circle"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card">
    <div class="card-body p-0">
        @if (Model.Needs.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>الموظف</th>
                            <th>الدائرة</th>
                            <th>المهارة</th>
                            <th class="text-center">المطلوب</th>
                            <th class="text-center">الحالي</th>
                            <th class="text-center">الفجوة</th>
                            <th>الأولوية</th>
                            <th>البرنامج المقترح</th>
                                <th>الحالة</th>
                                <th>الاعتماد</th>
                                <th style="width: 150px">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var n in Model.Needs)
                        {
                            <tr>
                                <td>
                                    <strong>@n.EmployeeName</strong>
                                    @if (!string.IsNullOrEmpty(n.EmployeeNumber))
                                    {
                                        <br /><small class="text-muted">@n.EmployeeNumber</small>
                                    }
                                </td>
                                <td><small>@n.Department</small></td>
                                <td>
                                    @n.SkillName
                                    @if (!string.IsNullOrEmpty(n.Category))
                                    {
                                        <br /><small class="text-muted">@n.Category</small>
                                    }
                                </td>
                                <td class="text-center">@n.RequiredLevel</td>
                                <td class="text-center">@n.CurrentLevel</td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">@n.Gap</span>
                                </td>
                                <td>
                                    @{
                                        var prBadge = TrainingNeed.GetPriorityBadge(n.Priority);
                                        var prText = prBadge == "warning" ? "text-dark" : "";
                                    }
                                    <span class="badge bg-@prBadge @prText">@TrainingNeed.GetPriorityDisplayName(n.Priority)</span>
                                </td>
                                <td style="max-width: 220px;">
                                    @{
                                        var suggestion = Model.Suggestions.TryGetValue(n.Id, out var sg) ? sg : null;
                                    }
                                    @if (suggestion != null)
                                    {
                                        <small class="@(suggestion.Matched ? "text-body" : "text-warning")">
                                            <i class="bi bi-lightbulb me-1"></i>@suggestion.Title
                                        </small>
                                    }
                                </td>
                                <td>
                                    @switch (n.Status)
                                    {
                                        case TrainingNeedStatus.Completed:
                                            <span class="badge bg-info">مكتمل</span>
                                            break;
                                        case TrainingNeedStatus.InProgress:
                                            <span class="badge bg-primary">قيد المعالجة</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark border">جديد</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-@TrainingNeed.GetApprovalStatusBadge(n.ApprovalStatus)">
                                        <i class="bi @TrainingNeed.GetApprovalStatusIcon(n.ApprovalStatus) me-1"></i>
                                        @TrainingNeed.GetApprovalStatusDisplayName(n.ApprovalStatus)
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@n.Id" class="btn btn-sm btn-outline-secondary" title="التفاصيل">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@n.Id" class="btn btn-sm btn-outline-primary" title="تعديل">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal@(n.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <div class="modal fade" id="deleteModal@(n.Id)" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">تأكيد الحذف</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p>هل أنت متأكد من حذف احتياج "<strong>@n.SkillName</strong>" للموظف "<strong>@n.EmployeeName</strong>"؟</p>
                                                    <p class="text-muted small mb-0">لا يمكن التراجع عن هذا الإجراء.</p>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                                                    <form asp-action="Delete" asp-route-id="@n.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger">
                                                            <i class="bi bi-trash me-1"></i> حذف
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="mb-3">
                    <i class="bi bi-clipboard-data text-muted" style="font-size: 3rem;"></i>
                </div>
                <h5 class="text-muted">لا توجد احتياجات تدريبية</h5>
                <p class="text-muted">ابدأ بإضافة احتياج يدوياً أو رفع ملف Excel لدائرتك</p>
            </div>
        }
    </div>
</div>

<!-- Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="ImportPreview" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">رفع ملف الاحتياجات (Excel)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>
                        استخدم قالب Excel الرسمي. ستظهر معاينة للبيانات قبل الحفظ النهائي.
                        @if (!Model.IsPrivileged)
                        {
                            <div class="mt-1">سيتم إسناد جميع السجلات إلى دائرتك تلقائياً.</div>
                        }
                    </div>
                    <div class="mb-2">
                        <label class="form-label">ملف Excel (.xlsx)</label>
                        <input type="file" name="file" accept=".xlsx,.xls" class="form-control" required />
                    </div>
                    <a asp-action="DownloadTemplate" class="small">
                        <i class="bi bi-download me-1"></i> تنزيل القالب
                    </a>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-eye me-1"></i> معاينة
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
