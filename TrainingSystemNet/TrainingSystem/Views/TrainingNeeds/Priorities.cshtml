@model List<TrainingSystem.Models.TrainingNeed>
@using TrainingSystem.Models
@{
    ViewData["Title"] = "الأولويات العالية";
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    var currentDept = ViewBag.CurrentDepartment as string;
    var isPrivileged = (bool)(ViewBag.IsPrivileged ?? false);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">الأولويات العالية</h4>
        <p class="text-muted mb-0">الاحتياجات ذات الفجوة الأكبر التي تتطلب معالجة عاجلة</p>
    </div>
    @if (isPrivileged)
    {
        <form method="get">
            <select name="department" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">كل الدوائر</option>
                @foreach (var d in departments)
                {
                    <option value="@d" selected="@(d == currentDept)">@d</option>
                }
            </select>
        </form>
    }
</div>

@if (!Model.Any())
{
    <div class="card"><div class="card-body text-center text-muted py-5">
        <i class="bi bi-check-circle fs-1 text-success d-block mb-2"></i>
        لا توجد احتياجات ذات أولوية عالية حالياً
    </div></div>
}
else
{
    <div class="row g-3">
        @foreach (var n in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-danger border-opacity-25">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-danger">فجوة @n.Gap</span>
                            <span class="badge bg-@TrainingNeed.GetApprovalStatusBadge(n.ApprovalStatus)">@TrainingNeed.GetApprovalStatusDisplayName(n.ApprovalStatus)</span>
                        </div>
                        <h6 class="fw-bold mb-1">@n.SkillName</h6>
                        <div class="small text-muted mb-3">@n.EmployeeName — @n.Department</div>
                        <div class="d-flex justify-content-between small mb-1">
                            <span>المستوى: @n.CurrentLevel / @n.RequiredLevel</span>
                        </div>
                        <div class="progress mb-3" style="height: 8px;">
                            <div class="progress-bar bg-danger" style="width: @((int)Math.Round(100.0 * n.Gap / 5))%"></div>
                        </div>
                        <a asp-action="Details" asp-route-id="@n.Id" class="btn btn-sm btn-outline-primary w-100">التفاصيل</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
