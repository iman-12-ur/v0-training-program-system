@model TrainingSystem.Controllers.TrainingNeedFormViewModel
@using TrainingSystem.Models
@{
    ViewData["Title"] = "تعديل احتياج تدريبي";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">تعديل احتياج تدريبي</h4>
        <p class="text-muted mb-0">تحديث بيانات الاحتياج التدريبي للموظف</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-right me-2"></i> رجوع
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">اختر موظفاً من النظام (اختياري)</label>
                    <select asp-for="EmployeeUserId" class="form-select" id="employeeSelect" asp-items="Model.Employees">
                        <option value="">— إدخال يدوي —</option>
                    </select>
                    <small class="text-muted">عند الاختيار تُملأ بيانات الموظف تلقائياً عبر الربط.</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label">اسم الموظف <span class="text-danger">*</span></label>
                    <input asp-for="EmployeeName" class="form-control" id="employeeName" />
                    <span asp-validation-for="EmployeeName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">الرقم الوظيفي</label>
                    <input asp-for="EmployeeNumber" class="form-control" id="employeeNumber" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">الدائرة</label>
                    <input class="form-control" value="@Model.Department" readonly />
                    <small class="text-muted">لا يمكن تغيير الدائرة بعد الإنشاء.</small>
                </div>

                <div class="col-md-6">
                    <label class="form-label">المسمى الوظيفي</label>
                    <input asp-for="JobTitle" class="form-control" id="jobTitle" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">الدرجة الوظيفية</label>
                    <input asp-for="Grade" class="form-control" id="grade" />
                </div>
                <div class="col-md-6" id="managerWrap" style="display:none;">
                    <label class="form-label">المدير المباشر</label>
                    <input type="text" class="form-control" id="managerName" readonly />
                    <small class="text-muted">يُعرض من بيانات الموظف (عبر الربط).</small>
                </div>

                @if (Model.Skills.Any())
                {
                    <div class="col-md-6">
                        <label class="form-label">اختر مهارة من المكتبة (اختياري)</label>
                        <select asp-for="SkillId" class="form-select" asp-items="Model.Skills">
                            <option value="">— إدخال يدوي —</option>
                        </select>
                    </div>
                }
                <div class="col-md-6">
                    <label class="form-label">المهارة <span class="text-danger">*</span></label>
                    <input asp-for="SkillName" class="form-control" />
                    <span asp-validation-for="SkillName" class="text-danger"></span>
                </div>

                @if (Model.SkillCategoryOptions.Any())
                {
                    <div class="col-md-6">
                        <label class="form-label">تصنيف المهارة</label>
                        <select asp-for="SkillCategoryId" class="form-select" asp-items="Model.SkillCategoryOptions">
                            <option value="">— غير محدد —</option>
                        </select>
                    </div>
                }
                <div class="col-md-6">
                    <label class="form-label">التصنيف (نص حر)</label>
                    <input asp-for="Category" class="form-control" list="categoryList" />
                    <datalist id="categoryList">
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Text"></option>
                        }
                    </datalist>
                </div>
                <div class="col-md-6">
                    <label class="form-label">نوع الفجوة المهارية</label>
                    <select asp-for="GapType" class="form-select" asp-items="Html.GetEnumSelectList<TrainingSystem.Models.SkillGapType>()">
                        <option value="">— يُشتقّ تلقائياً من تصنيف المهارة —</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">الحالة</label>
                    <select asp-for="Status" class="form-select">
                        <option value="@TrainingNeedStatus.New">جديد</option>
                        <option value="@TrainingNeedStatus.InProgress">قيد المعالجة</option>
                        <option value="@TrainingNeedStatus.Completed">مكتمل</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">المستوى المطلوب <span class="text-danger">*</span></label>
                    <select asp-for="RequiredLevel" class="form-select">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                    <span asp-validation-for="RequiredLevel" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">المستوى الحالي <span class="text-danger">*</span></label>
                    <select asp-for="CurrentLevel" class="form-select">
                        @for (int i = 0; i <= 5; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                    <span asp-validation-for="CurrentLevel" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">الفترة الزمنية المقترحة</label>
                    <input asp-for="SuggestedTimeframe" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">مبرر الاحتياج / سبب التدريب</label>
                    <input asp-for="Justification" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label">وصف الاحتياج</label>
                    <textarea asp-for="NeedDescription" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">البرنامج التدريبي المقترح</label>
                    <input asp-for="ProposedTrainingProgram" class="form-control" placeholder="اسم البرنامج المقترح (نصياً)" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">مزوّد التدريب المفضّل</label>
                    <input asp-for="PreferredTrainingProvider" class="form-control" placeholder="جهة/مركز التدريب المفضّل" />
                </div>

                <div class="col-12"><hr class="my-1" /><div class="fw-semibold text-muted small">التكلفة والأثر والميزانية</div></div>

                @if (Model.Programs.Any())
                {
                    <div class="col-md-6">
                        <label class="form-label">ربط ببرنامج تدريبي موجود</label>
                        <select asp-for="LinkedTrainingProgramId" class="form-select" asp-items="Model.Programs">
                            <option value="">— بدون ربط —</option>
                        </select>
                        <div class="form-text">يُربط ببرنامج قائم؛ لا يُنشأ برنامج جديد.</div>
                    </div>
                }
                @if (Model.Batches.Any())
                {
                    <div class="col-md-6">
                        <label class="form-label">الدفعة التدريبية</label>
                        <select asp-for="TrainingBatchId" class="form-select" asp-items="Model.Batches">
                            <option value="">— بدون دفعة —</option>
                        </select>
                        <div class="form-text">عند اختيار دفعة يُضبط البرنامج تلقائياً حسبها.</div>
                    </div>
                }
                <div class="col-md-6">
                    <label class="form-label">التكلفة التقديرية</label>
                    <input asp-for="EstimatedCost" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">التكلفة المخطّطة</label>
                    <input asp-for="PlannedCost" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">التكلفة الفعلية</label>
                    <input asp-for="ActualCost" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">التاريخ المخطّط</label>
                    <input asp-for="PlannedDate" type="date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">تاريخ الإنجاز</label>
                    <input asp-for="CompletionDate" type="date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">عدد المشاركين</label>
                    <input asp-for="ParticipantsCount" type="number" min="1" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">الأثر على العمل (1-4)</label>
                    <select asp-for="ImpactScore" class="form-select">
                        @for (int i = 1; i <= 4; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">درجة المخاطر (1-4)</label>
                    <select asp-for="RiskScore" class="form-select">
                        @for (int i = 1; i <= 4; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsCompliance" class="form-check-input" type="checkbox" id="isCompliance" />
                        <label class="form-check-label" for="isCompliance">احتياج امتثال إلزامي (يرفع الأولوية)</label>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label">ملاحظات</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-2"></i> حفظ التعديلات
                </button>
                <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // تعبئة بيانات الموظف تلقائياً عبر الربط (FK) عند الاختيار — دون تكرار الإدخال
        (function () {
            var select = document.getElementById('employeeSelect');
            if (!select) return;

            var infoUrl = '@Url.Action("EmployeeInfo", "TrainingNeeds")';
            var fName = document.getElementById('employeeName');
            var fNumber = document.getElementById('employeeNumber');
            var fJob = document.getElementById('jobTitle');
            var fGrade = document.getElementById('grade');
            var fManager = document.getElementById('managerName');
            var managerWrap = document.getElementById('managerWrap');
            var linked = [fName, fNumber, fJob, fGrade].filter(Boolean);

            function setLinked(readonly) {
                linked.forEach(function (el) {
                    el.readOnly = readonly;
                    el.classList.toggle('bg-light', readonly);
                });
            }

            function load(id, silent) {
                if (!id) {
                    setLinked(false);
                    if (fManager) fManager.value = '';
                    if (managerWrap) managerWrap.style.display = 'none';
                    return;
                }
                fetch(infoUrl + '?id=' + encodeURIComponent(id), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (!d || !d.ok) { setLinked(false); return; }
                        // عند التحميل الأولي لا نطمس القيم إلا لعرض المدير وقفل الحقول
                        if (!silent) {
                            if (fName) fName.value = d.fullName || '';
                            if (fNumber) fNumber.value = d.employeeNumber || '';
                            if (fJob) fJob.value = d.jobTitle || '';
                            if (fGrade) fGrade.value = d.grade || '';
                        }
                        if (fManager) fManager.value = d.managerName || '—';
                        if (managerWrap) managerWrap.style.display = '';
                        setLinked(true);
                    })
                    .catch(function () { setLinked(false); });
            }

            select.addEventListener('change', function () { load(this.value, false); });
            // تحميل أولي إن كان الاحتياج مربوطاً بموظف مسبقاً
            if (select.value) load(select.value, true);
        })();
    </script>
}
