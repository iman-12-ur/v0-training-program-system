@model TrainingProgram
@{
    ViewData["Title"] = "تعديل البرنامج";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-pencil me-2 text-primary"></i> تعديل البرنامج
    </h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-2"></i> رجوع
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <!-- Basic Info -->
            <h5 class="fw-bold mb-3 pb-2 border-bottom">
                <i class="bi bi-info-circle text-primary me-2"></i> المعلومات الأساسية
            </h5>
            
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label">عنوان البرنامج <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ProgramType" class="form-label">نوع البرنامج</label>
                    <select asp-for="ProgramType" class="form-select">
                        <option value="">اختر نوع البرنامج</option>
                        <option value="دورة تدريبية">دورة تدريبية</option>
                        <option value="ورشة عمل">ورشة عمل</option>
                        <option value="شهادة معتمدة">شهادة معتمدة</option>
                        <option value="تطوير مهني">تطوير مهني</option>
                    </select>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label">وصف البرنامج <span class="text-danger">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Categories" class="form-label">التصنيفات</label>
                    <input asp-for="Categories" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="TargetAudience" class="form-label">الفئة المستهدفة</label>
                    <input asp-for="TargetAudience" class="form-control" />
                </div>
            </div>

            <!-- Program Details -->
            <h5 class="fw-bold mb-3 pb-2 border-bottom">
                <i class="bi bi-gear text-primary me-2"></i> تفاصيل البرنامج
            </h5>
            
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Duration" class="form-label">المدة <span class="text-danger">*</span></label>
                    <input asp-for="Duration" class="form-control" />
                    <span asp-validation-for="Duration" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Instructor" class="form-label">المدرب <span class="text-danger">*</span></label>
                    <input asp-for="Instructor" class="form-control" />
                    <span asp-validation-for="Instructor" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Location" class="form-label">الموقع <span class="text-danger">*</span></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Status" class="form-label">حالة البرنامج</label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ProgramStatus>()"></select>
                </div>
                <div class="col-12">
                    <label asp-for="Logo" class="form-label">رابط الشعار</label>
                    <input asp-for="Logo" class="form-control" />
                </div>
            </div>

            <!-- Registration Period -->
            <h5 class="fw-bold mb-3 pb-2 border-bottom">
                <i class="bi bi-calendar-check text-primary me-2"></i> فترة الترشيح
            </h5>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="RegistrationStartDate" class="form-label">بداية فترة الترشيح</label>
                    <input asp-for="RegistrationStartDate" type="date" class="form-control" value="@(Model.RegistrationStartDate?.ToString("yyyy-MM-dd"))" />
                    <span asp-validation-for="RegistrationStartDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="RegistrationEndDate" class="form-label">نهاية فترة الترشيح</label>
                    <input asp-for="RegistrationEndDate" type="date" class="form-control" value="@(Model.RegistrationEndDate?.ToString("yyyy-MM-dd"))" />
                    <span asp-validation-for="RegistrationEndDate" class="text-danger small"></span>
                </div>
            </div>

            <!-- Objectives & Topics -->
            <h5 class="fw-bold mb-3 pb-2 border-bottom">
                <i class="bi bi-list-check text-primary me-2"></i> الأهداف والمحاور
            </h5>
            
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Objectives" class="form-label">أهداف البرنامج</label>
                    <textarea asp-for="Objectives" class="form-control" rows="4"></textarea>
                </div>
                <div class="col-md-6">
                    <label asp-for="Topics" class="form-label">محاور البرنامج</label>
                    <textarea asp-for="Topics" class="form-control" rows="4"></textarea>
                </div>
                <div class="col-12">
                    <label asp-for="Prerequisites" class="form-label">المتطلبات المسبقة</label>
                    <textarea asp-for="Prerequisites" class="form-control" rows="2"></textarea>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-check-lg me-2"></i> حفظ التعديلات
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-x-lg me-2"></i> إلغاء
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
