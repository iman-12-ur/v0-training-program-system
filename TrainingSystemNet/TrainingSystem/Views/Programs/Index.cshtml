@model IEnumerable<TrainingProgram>
@{
    ViewData["Title"] = "البرامج التدريبية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-collection me-2 text-primary"></i> البرامج التدريبية
    </h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i> إضافة برنامج
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th style="width: 40%">البرنامج</th>
                            <th>النوع</th>
                            <th>المدرب</th>
                            <th>الدفعات</th>
                            <th>الحالة</th>
                            <th style="width: 150px">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var program in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@program.Title</strong>
                                    <br /><small class="text-muted">@program.Duration - @program.Location</small>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(program.ProgramType))
                                    {
                                        <span class="badge bg-secondary">@program.ProgramType</span>
                                    }
                                </td>
                                <td>@program.Instructor</td>
                                <td>
                                    <span class="badge bg-info">@program.Batches.Count دفعة</span>
                                </td>
                                <td>
                                    @switch (program.Status)
                                    {
                                        case ProgramStatus.Active:
                                            <span class="badge bg-success">نشط</span>
                                            break;
                                        case ProgramStatus.Inactive:
                                            <span class="badge bg-secondary">غير نشط</span>
                                            break;
                                        case ProgramStatus.Draft:
                                            <span class="badge bg-warning">مسودة</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@program.Id" class="btn btn-sm btn-outline-primary" title="تعديل">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@program.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-@(program.Status == ProgramStatus.Active ? "warning" : "success")" 
                                                    title="@(program.Status == ProgramStatus.Active ? "إيقاف" : "تفعيل")">
                                                <i class="bi bi-@(program.Status == ProgramStatus.Active ? "pause" : "play")"></i>
                                            </button>
                                        </form>
                                        <a asp-controller="Batches" asp-action="Create" asp-route-programId="@program.Id" 
                                           class="btn btn-sm btn-outline-info" title="إضافة دفعة">
                                            <i class="bi bi-plus"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal@(program.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Modal -->
                                    <div class="modal fade" id="deleteModal@(program.Id)" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">تأكيد الحذف</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    هل أنت متأكد من حذف البرنامج "@program.Title"؟
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                                                    <form asp-action="Delete" asp-route-id="@program.Id" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-danger">حذف</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 mb-3 d-block"></i>
                لا توجد برامج تدريبية
                <br />
                <a asp-action="Create" class="btn btn-primary mt-3">
                    <i class="bi bi-plus-lg me-2"></i> إضافة برنامج جديد
                </a>
            </div>
        }
    </div>
</div>
