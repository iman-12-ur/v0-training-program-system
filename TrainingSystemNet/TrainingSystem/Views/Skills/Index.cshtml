@model TrainingSystem.Controllers.SkillsIndexViewModel
@{
    ViewData["Title"] = "مكتبة المهارات";
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">مكتبة المهارات</h4>
    <p class="text-muted mb-0">إدارة تصنيفات المهارات والمهارات المستخدمة في نماذج الاحتياجات التدريبية</p>
</div>

<div class="row g-4">
    <!-- التصنيفات -->
    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header bg-white"><h6 class="fw-bold mb-0">إضافة تصنيف</h6></div>
            <div class="card-body">
                <form asp-action="CreateCategory" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label">اسم التصنيف <span class="text-danger">*</span></label>
                        <input name="name" class="form-control" required placeholder="مثال: مهارات قيادية" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">الوصف</label>
                        <input name="description" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i> إضافة</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">التصنيفات</h6>
                <span class="badge bg-secondary">@Model.Categories.Count</span>
            </div>
            <ul class="list-group list-group-flush">
                @if (!Model.Categories.Any())
                {
                    <li class="list-group-item text-center text-muted py-4">لا توجد تصنيفات</li>
                }
                @foreach (var c in Model.Categories)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-semibold">@c.Name</span>
                            @if (!c.IsActive)
                            {
                                <span class="badge bg-secondary ms-1">معطّل</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(c.Description))
                            {
                                <div class="small text-muted">@c.Description</div>
                            }
                        </div>
                        <div class="d-flex gap-1">
                            <form asp-action="ToggleCategory" asp-route-id="@c.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-secondary" title="تفعيل/تعطيل">
                                    <i class="bi @(c.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                </button>
                            </form>
                            <form asp-action="DeleteCategory" asp-route-id="@c.Id" method="post"
                                  onsubmit="return confirm('حذف التصنيف؟');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger" title="حذف"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- المهارات -->
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header bg-white"><h6 class="fw-bold mb-0">إضافة مهارة</h6></div>
            <div class="card-body">
                <form asp-action="CreateSkill" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">اسم المهارة <span class="text-danger">*</span></label>
                            <input name="name" class="form-control" required placeholder="مثال: إدارة المشاريع" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">التصنيف</label>
                            <select name="skillCategoryId" class="form-select" asp-items="Model.CategoryOptions">
                                <option value="">— بدون تصنيف —</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">الوصف</label>
                            <input name="description" class="form-control" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm mt-2"><i class="bi bi-plus-lg me-1"></i> إضافة</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">المهارات</h6>
                <span class="badge bg-secondary">@Model.Skills.Count</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>المهارة</th><th>التصنيف</th><th class="text-center">الحالة</th><th></th></tr>
                    </thead>
                    <tbody>
                        @if (!Model.Skills.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">لا توجد مهارات</td></tr>
                        }
                        @foreach (var s in Model.Skills)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@s.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(s.Description))
                                    {
                                        <div class="small text-muted">@s.Description</div>
                                    }
                                </td>
                                <td>@(s.SkillCategory?.Name ?? "—")</td>
                                <td class="text-center">
                                    <span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">@(s.IsActive ? "نشط" : "معطّل")</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <form asp-action="ToggleSkill" asp-route-id="@s.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-secondary" title="تفعيل/تعطيل">
                                                <i class="bi @(s.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                            </button>
                                        </form>
                                        <form asp-action="DeleteSkill" asp-route-id="@s.Id" method="post"
                                              onsubmit="return confirm('حذف المهارة؟');">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger" title="حذف"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
