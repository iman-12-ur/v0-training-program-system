@model IEnumerable<Registration>
@{
    ViewData["Title"] = "لوحة التحكم";
}

<!-- Welcome Section -->
<div class="bg-primary bg-gradient text-white rounded-4 p-4 mb-4">
    <h2 class="fw-bold">@ViewBag.AdminWelcome @ViewBag.AdminName</h2>
    <p class="mb-0 opacity-75">@ViewBag.AdminDescription</p>
</div>

<!-- Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="bi bi-collection text-primary fs-4"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 fw-bold">@ViewBag.TotalPrograms</h3>
                        <small class="text-muted">البرامج التدريبية</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="bi bi-calendar3 text-success fs-4"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 fw-bold">@ViewBag.TotalBatches</h3>
                        <small class="text-muted">الدفعات</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="bg-info bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="bi bi-people text-info fs-4"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 fw-bold">@ViewBag.TotalRegistrations</h3>
                        <small class="text-muted">إجمالي الطلبات</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="bg-warning bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="bi bi-hourglass-split text-warning fs-4"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 fw-bold">@ViewBag.PendingRegistrations</h3>
                        <small class="text-muted">قيد المراجعة</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <a asp-controller="Programs" asp-action="Create" class="card border-0 shadow-sm text-decoration-none h-100">
            <div class="card-body text-center py-4">
                <i class="bi bi-plus-circle text-primary fs-1 mb-3"></i>
                <h5 class="fw-bold">إضافة برنامج</h5>
                <p class="text-muted small mb-0">إضافة برنامج تدريبي جديد</p>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Batches" asp-action="Create" class="card border-0 shadow-sm text-decoration-none h-100">
            <div class="card-body text-center py-4">
                <i class="bi bi-calendar-plus text-success fs-1 mb-3"></i>
                <h5 class="fw-bold">إضافة دفعة</h5>
                <p class="text-muted small mb-0">إضافة دفعة جديدة لبرنامج</p>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Registrations" asp-action="Index" class="card border-0 shadow-sm text-decoration-none h-100">
            <div class="card-body text-center py-4">
                <i class="bi bi-person-lines-fill text-info fs-1 mb-3"></i>
                <h5 class="fw-bold">طلبات الترشيح</h5>
                <p class="text-muted small mb-0">إدارة طلبات الترشيح</p>
            </div>
        </a>
    </div>
</div>

<!-- Recent Registrations -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i> آخر الطلبات</h5>
        <a asp-controller="Registrations" asp-action="Index" class="btn btn-sm btn-outline-primary">عرض الكل</a>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>الموظف</th>
                            <th>البرنامج</th>
                            <th>الدفعة</th>
                            <th>التاريخ</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reg in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@reg.VisitorName</strong>
                                    <br /><small class="text-muted">@reg.EmployeeId</small>
                                </td>
                                <td>@reg.Batch?.TrainingProgram?.Title</td>
                                <td>@reg.Batch?.Name</td>
                                <td>@reg.RegisteredAt.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @switch (reg.Status)
                                    {
                                        case RegistrationStatus.Pending:
                                            <span class="badge bg-warning">قيد المراجعة</span>
                                            break;
                                        case RegistrationStatus.Approved:
                                            <span class="badge bg-success">مقبول</span>
                                            break;
                                        case RegistrationStatus.Rejected:
                                            <span class="badge bg-danger">مرفوض</span>
                                            break;
                                        case RegistrationStatus.Completed:
                                            <span class="badge bg-info">مكتمل</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 mb-3 d-block"></i>
                لا توجد طلبات حتى الآن
            </div>
        }
    </div>
</div>
