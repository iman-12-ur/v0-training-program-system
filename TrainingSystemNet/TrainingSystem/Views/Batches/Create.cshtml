@model Batch
@{
    ViewData["Title"] = "إضافة دفعة";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-calendar-plus me-2 text-primary"></i> إضافة دفعة جديدة
    </h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-2"></i> رجوع
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="TrainingProgramId" class="form-label">البرنامج التدريبي <span class="text-danger">*</span></label>
                            <select asp-for="TrainingProgramId" class="form-select" asp-items="ViewBag.Programs">
                                <option value="">اختر البرنامج</option>
                            </select>
                            <span asp-validation-for="TrainingProgramId" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Name" class="form-label">اسم الدفعة <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="مثال: الدفعة الأولى - يناير 2024" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label">تاريخ البدء <span class="text-danger">*</span></label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label">تاريخ الانتهاء <span class="text-danger">*</span></label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MaxParticipants" class="form-label">الحد الأقصى للمشاركين <span class="text-danger">*</span></label>
                            <input asp-for="MaxParticipants" type="number" class="form-control" min="1" placeholder="مثال: 30" />
                            <span asp-validation-for="MaxParticipants" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label">حالة الدفعة</label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<BatchStatus>()"></select>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-check-lg me-2"></i> حفظ الدفعة
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-x-lg me-2"></i> إلغاء
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
