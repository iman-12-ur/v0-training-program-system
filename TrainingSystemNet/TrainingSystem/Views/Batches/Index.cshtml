@model IEnumerable<Batch>
@{
    ViewData["Title"] = "الدفعات التدريبية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-calendar3 me-2 text-primary"></i> الدفعات التدريبية
    </h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i> إضافة دفعة
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>الدفعة</th>
                            <th>البرنامج</th>
                            <th>التاريخ</th>
                            <th>المشاركين</th>
                            <th>الحالة</th>
                            <th style="width: 120px">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var batch in Model)
                        {
                            <tr>
                                <td><strong>@batch.Name</strong></td>
                                <td>@batch.TrainingProgram?.Title</td>
                                <td>
                                    <small>
                                        @batch.StartDate.ToString("yyyy/MM/dd") - @batch.EndDate.ToString("yyyy/MM/dd")
                                    </small>
                                </td>
                                <td>
                                    <div class="progress" style="height: 20px; width: 100px;">
                                        @{
                                            var percentage = batch.MaxParticipants > 0 
                                                ? (batch.CurrentParticipants * 100 / batch.MaxParticipants) 
                                                : 0;
                                        }
                                        <div class="progress-bar @(percentage >= 100 ? "bg-danger" : percentage >= 75 ? "bg-warning" : "bg-success")" 
                                             style="width: @percentage%">
                                        </div>
                                    </div>
                                    <small class="text-muted">@batch.CurrentParticipants / @batch.MaxParticipants</small>
                                </td>
                                <td>
                                    @switch (batch.Status)
                                    {
                                        case BatchStatus.Upcoming:
                                            <span class="badge bg-info">قادمة</span>
                                            break;
                                        case BatchStatus.InProgress:
                                            <span class="badge bg-primary">جارية</span>
                                            break;
                                        case BatchStatus.Completed:
                                            <span class="badge bg-success">مكتملة</span>
                                            break;
                                        case BatchStatus.Cancelled:
                                            <span class="badge bg-danger">ملغاة</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@batch.Id" class="btn btn-sm btn-outline-primary" title="تعديل">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal@(batch.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Modal -->
                                    <div class="modal fade" id="deleteModal@(batch.Id)" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">تأكيد الحذف</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    هل أنت متأكد من حذف الدفعة "@batch.Name"؟
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                                                    <form asp-action="Delete" asp-route-id="@batch.Id" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-danger">حذف</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-calendar-x fs-1 mb-3 d-block"></i>
                لا توجد دفعات
                <br />
                <a asp-action="Create" class="btn btn-primary mt-3">
                    <i class="bi bi-plus-lg me-2"></i> إضافة دفعة جديدة
                </a>
            </div>
        }
    </div>
</div>
