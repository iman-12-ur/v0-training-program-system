@model TrainingSystem.Controllers.CreateUserViewModel
@using TrainingSystem.Models
@{
    ViewData["Title"] = "إضافة مستخدم جديد";
    var allRoles = ViewBag.AllRoles as List<string>;
}

<div class="container py-4" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-person-plus me-2"></i>إضافة مستخدم جديد</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateUser" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FullName" class="form-label">الاسم الكامل <span class="text-danger">*</span></label>
                                <input asp-for="FullName" class="form-control" placeholder="أدخل الاسم الكامل" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Username" class="form-label">اسم المستخدم <span class="text-danger">*</span></label>
                                <input asp-for="Username" class="form-control" placeholder="أدخل اسم المستخدم" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label">البريد الإلكتروني <span class="text-danger">*</span></label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="example@email.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label">رقم الهاتف</label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="05xxxxxxxx" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label">كلمة المرور <span class="text-danger">*</span></label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="أدخل كلمة المرور" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label">تأكيد كلمة المرور <span class="text-danger">*</span></label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="أعد إدخال كلمة المرور" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Department" class="form-label">القسم</label>
                                <input asp-for="Department" class="form-control" placeholder="أدخل اسم القسم" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Role" class="form-label">الدور <span class="text-danger">*</span></label>
                                <select asp-for="Role" class="form-select" id="roleSelect">
                                    @foreach (var role in allRoles ?? new List<string>())
                                    {
                                        <option value="@role">@SystemRoles.GetRoleDisplayName(role)</option>
                                    }
                                </select>
                                <span asp-validation-for="Role" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- وصف الصلاحيات -->
                        <div class="alert alert-info mb-4" id="roleDescription">
                            <i class="bi bi-info-circle me-2"></i>
                            <span id="roleDescText">اختر دوراً لعرض صلاحياته</span>
                        </div>

                        <!-- صلاحيات المشرف المخصصة -->
                        <div id="supervisorPermissions" class="mb-4" style="display: none;">
                            <div class="card bg-light">
                                <div class="card-header">
                                    <h6 class="mb-0"><i class="bi bi-shield-lock me-2"></i>صلاحيات المشرف المخصصة</h6>
                                    <small class="text-muted">حدد الصلاحيات التي تريد منحها لهذا المشرف</small>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <!-- البرامج التدريبية -->
                                        <div class="col-md-4 mb-3">
                                            <h6 class="text-primary"><i class="bi bi-collection me-2"></i>البرامج التدريبية</h6>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Programs.View" id="perm_programs_view" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_programs_view">عرض البرامج</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Programs.Create" id="perm_programs_create" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_programs_create">إضافة البرامج</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Programs.Edit" id="perm_programs_edit" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_programs_edit">تعديل البرامج</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Programs.Delete" id="perm_programs_delete" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_programs_delete">حذف البرامج</label>
                                            </div>
                                        </div>

                                        <!-- الدفعات -->
                                        <div class="col-md-4 mb-3">
                                            <h6 class="text-primary"><i class="bi bi-calendar3 me-2"></i>الدفعات</h6>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Batches.View" id="perm_batches_view" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_batches_view">عرض الدفعات</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Batches.Create" id="perm_batches_create" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_batches_create">إضافة الدفعات</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Batches.Edit" id="perm_batches_edit" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_batches_edit">تعديل الدفعات</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Batches.Delete" id="perm_batches_delete" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_batches_delete">حذف الدفعات</label>
                                            </div>
                                        </div>

                                        <!-- طلبات الترشيح -->
                                        <div class="col-md-4 mb-3">
                                            <h6 class="text-primary"><i class="bi bi-person-lines-fill me-2"></i>طلبات الترشيح</h6>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Registrations.View" id="perm_reg_view" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_reg_view">عرض الطلبات</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Registrations.Approve" id="perm_reg_approve" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_reg_approve">قبول الطلبات</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Registrations.Reject" id="perm_reg_reject" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_reg_reject">رفض الطلبات</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Registrations.Delete" id="perm_reg_delete" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_reg_delete">حذف الطلبات</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Registrations.Export" id="perm_reg_export" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_reg_export">تصدير الطلبات</label>
                                            </div>
                                        </div>

                                        <!-- التقارير -->
                                        <div class="col-md-4 mb-3">
                                            <h6 class="text-primary"><i class="bi bi-bar-chart me-2"></i>التقارير</h6>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Reports.View" id="perm_reports_view" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_reports_view">عرض التقارير</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Reports.Export" id="perm_reports_export" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_reports_export">تصدير التقارير</label>
                                            </div>
                                        </div>

                                        <!-- الإعدادات -->
                                        <div class="col-md-4 mb-3">
                                            <h6 class="text-primary"><i class="bi bi-gear me-2"></i>الإعدادات</h6>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Settings.View" id="perm_settings_view" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_settings_view">عرض الإعدادات</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input permission-check" type="checkbox" value="Settings.Edit" id="perm_settings_edit" name="CustomPermissions">
                                                <label class="form-check-label" for="perm_settings_edit">تعديل الإعدادات</label>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- أزرار سريعة -->
                                    <div class="mt-3 pt-3 border-top">
                                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="selectAllPermissions()">
                                            <i class="bi bi-check-all me-1"></i>تحديد الكل
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearAllPermissions()">
                                            <i class="bi bi-x-lg me-1"></i>إلغاء الكل
                                        </button>
                                        <button type="button" class="btn btn-outline-info btn-sm" onclick="selectViewOnly()">
                                            <i class="bi bi-eye me-1"></i>عرض فقط
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" name="CustomPermissions" id="customPermissionsHidden" />

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Users" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-right me-2"></i>رجوع
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-2"></i>حفظ المستخدم
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var roleDescriptions = {
            'SuperAdmin': 'كل الصلاحيات - إدارة المستخدمين والإعدادات والبرامج',
            'Admin': 'كل الصلاحيات - إدارة المستخدمين والإعدادات والبرامج',
            'Supervisor': 'صلاحيات مخصصة يحددها المدير'
        };

        document.addEventListener('DOMContentLoaded', function() {
            updatePermissionsSection();
        });

        document.getElementById('roleSelect').addEventListener('change', function() {
            updatePermissionsSection();
        });

        function updatePermissionsSection() {
            var role = document.getElementById('roleSelect').value;
            var desc = roleDescriptions[role] || '';
            document.getElementById('roleDescText').textContent = desc;
            
            var permSection = document.getElementById('supervisorPermissions');
            if (role === 'Supervisor') {
                permSection.style.display = 'block';
            } else {
                permSection.style.display = 'none';
            }
        }

        function selectAllPermissions() {
            document.querySelectorAll('.permission-check').forEach(function(cb) {
                cb.checked = true;
            });
            updateHiddenField();
        }

        function clearAllPermissions() {
            document.querySelectorAll('.permission-check').forEach(function(cb) {
                cb.checked = false;
            });
            updateHiddenField();
        }

        function selectViewOnly() {
            clearAllPermissions();
            var viewPermissions = ['Programs.View', 'Batches.View', 'Registrations.View', 'Reports.View', 'Settings.View'];
            viewPermissions.forEach(function(perm) {
                var checkbox = document.querySelector('input[value="' + perm + '"]');
                if (checkbox) {
                    checkbox.checked = true;
                }
            });
            updateHiddenField();
        }

        function updateHiddenField() {
            var checked = [];
            document.querySelectorAll('.permission-check:checked').forEach(function(cb) {
                checked.push(cb.value);
            });
            document.getElementById('customPermissionsHidden').value = checked.join(',');
        }

        // تحديث الحقل المخفي عند أي تغيير
        document.querySelectorAll('.permission-check').forEach(function(cb) {
            cb.addEventListener('change', updateHiddenField);
        });
    </script>
}
