@model List<Registration>
@{
    ViewData["Title"] = "إدارة طلبات الترشيح";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people text-primary me-2"></i>إدارة طلبات الترشيح</h2>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">البحث</label>
                <input type="text" name="search" class="form-control" placeholder="ابحث بالاسم أو الرقم الوظيفي" value="@ViewBag.CurrentSearch">
            </div>
            <div class="col-md-3">
                <label class="form-label">الحالة</label>
                <select name="status" class="form-select">
                    <option value="">جميع الحالات</option>
                    <option value="Pending" selected="@(ViewBag.CurrentStatus == "Pending")">قيد المراجعة</option>
                    <option value="Approved" selected="@(ViewBag.CurrentStatus == "Approved")">مقبول</option>
                    <option value="Rejected" selected="@(ViewBag.CurrentStatus == "Rejected")">مرفوض</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">البرنامج</label>
                <select name="programId" class="form-select">
                    <option value="">جميع البرامج</option>
                    @foreach (var program in ViewBag.Programs as List<TrainingProgram>)
                    {
                        <option value="@program.Id" selected="@(ViewBag.CurrentProgramId == program.Id)">@program.Title</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i>بحث
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>الاسم</th>
                        <th>الرقم الوظيفي</th>
                        <th>الدائرة/المحكمة</th>
                        <th>البرنامج</th>
                        <th>الدفعة</th>
                        <th>تاريخ التسجيل</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reg in Model)
                    {
                        <tr>
                            <td>@reg.Id</td>
                            <td>
                                <strong>@reg.VisitorName</strong>
                                <br><small class="text-muted">@reg.Email</small>
                            </td>
                            <td dir="ltr">@reg.EmployeeId</td>
                            <td>@reg.Court</td>
                            <td>@reg.Batch?.TrainingProgram?.Title</td>
                            <td>@reg.Batch?.Name</td>
                            <td>@reg.RegisteredAt.ToString("yyyy/MM/dd")</td>
                            <td>
                                @switch (reg.Status)
                                {
                                    case RegistrationStatus.Pending:
                                        <span class="badge bg-warning">قيد المراجعة</span>
                                        break;
                                    case RegistrationStatus.Approved:
                                        <span class="badge bg-success">مقبول</span>
                                        break;
                                    case RegistrationStatus.Rejected:
                                        <span class="badge bg-danger">مرفوض</span>
                                        break;
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@reg.Id" class="btn btn-sm btn-outline-info" title="التفاصيل">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (reg.Status == RegistrationStatus.Pending)
                                    {
                                        <form asp-action="Approve" asp-route-id="@reg.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="قبول">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Reject" asp-route-id="@reg.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="رفض">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="Delete" asp-route-id="@reg.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا الطلب؟')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-4">
        <i class="bi bi-info-circle me-2"></i>لا توجد طلبات ترشيح مطابقة للبحث
    </div>
}
