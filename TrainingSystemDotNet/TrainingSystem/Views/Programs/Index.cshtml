@model List<TrainingProgram>
@{
    ViewData["Title"] = "إدارة البرامج التدريبية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-journal-text text-primary me-2"></i>إدارة البرامج التدريبية</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>إضافة برنامج جديد
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>عنوان البرنامج</th>
                        <th>نوع البرنامج</th>
                        <th>المدة</th>
                        <th>المدرب</th>
                        <th>الدفعات</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var program in Model)
                    {
                        <tr>
                            <td>@program.Id</td>
                            <td>
                                <strong>@program.Title</strong>
                                @if (!string.IsNullOrEmpty(program.Categories))
                                {
                                    <br>
                                    <small class="text-muted">@program.Categories</small>
                                }
                            </td>
                            <td>@(program.ProgramType ?? "-")</td>
                            <td>@program.Duration</td>
                            <td>@program.Instructor</td>
                            <td>
                                <span class="badge bg-info">@program.Batches.Count دفعة</span>
                            </td>
                            <td>
                                @switch (program.Status)
                                {
                                    case ProgramStatus.Active:
                                        <span class="badge bg-success">نشط</span>
                                        break;
                                    case ProgramStatus.Inactive:
                                        <span class="badge bg-secondary">غير نشط</span>
                                        break;
                                    case ProgramStatus.Draft:
                                        <span class="badge bg-warning">مسودة</span>
                                        break;
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@program.Id" class="btn btn-sm btn-outline-primary" title="تعديل">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleStatus" asp-route-id="@program.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-warning" title="تغيير الحالة">
                                            @if (program.Status == ProgramStatus.Active)
                                            {
                                                <i class="bi bi-pause-circle"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-play-circle"></i>
                                            }
                                        </button>
                                    </form>
                                    <a asp-controller="Batches" asp-action="Create" asp-route-programId="@program.Id" class="btn btn-sm btn-outline-success" title="إضافة دفعة">
                                        <i class="bi bi-calendar-plus"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@program.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا البرنامج؟')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-4">
        <i class="bi bi-info-circle me-2"></i>لا توجد برامج تدريبية. <a asp-action="Create">أضف برنامجاً جديداً</a>
    </div>
}
