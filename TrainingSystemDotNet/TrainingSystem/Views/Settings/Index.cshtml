@model SystemSettings
@{
    ViewData["Title"] = "إعدادات النظام";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-gear text-primary me-2"></i>إعدادات النظام</h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Index" method="post">
                    <input type="hidden" asp-for="Id" />

                    <h5 class="mb-3 text-primary"><i class="bi bi-house me-2"></i>إعدادات الصفحة الرئيسية</h5>
                    
                    <div class="mb-3">
                        <label asp-for="WelcomeTitle" class="form-label"></label>
                        <input asp-for="WelcomeTitle" class="form-control" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="WelcomeDescription" class="form-label"></label>
                        <textarea asp-for="WelcomeDescription" class="form-control" rows="3"></textarea>
                    </div>

                    <hr class="my-4">

                    <h5 class="mb-3 text-primary"><i class="bi bi-speedometer2 me-2"></i>إعدادات لوحة التحكم</h5>

                    <div class="mb-3">
                        <label asp-for="AdminWelcome" class="form-label"></label>
                        <input asp-for="AdminWelcome" class="form-control" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="AdminDescription" class="form-label"></label>
                        <textarea asp-for="AdminDescription" class="form-control" rows="2"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-2"></i>حفظ الإعدادات
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
