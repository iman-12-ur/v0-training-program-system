@model List<Batch>
@{
    ViewData["Title"] = "إدارة الدفعات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-calendar3 text-primary me-2"></i>إدارة الدفعات</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>إضافة دفعة جديدة
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>اسم الدفعة</th>
                        <th>البرنامج التدريبي</th>
                        <th>تاريخ البداية</th>
                        <th>تاريخ النهاية</th>
                        <th>المشاركين</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var batch in Model)
                    {
                        <tr>
                            <td>@batch.Id</td>
                            <td><strong>@batch.Name</strong></td>
                            <td>@batch.TrainingProgram?.Title</td>
                            <td>@batch.StartDate.ToString("yyyy/MM/dd")</td>
                            <td>@batch.EndDate.ToString("yyyy/MM/dd")</td>
                            <td>
                                <span class="badge bg-info">@batch.CurrentParticipants / @batch.MaxParticipants</span>
                            </td>
                            <td>
                                @switch (batch.Status)
                                {
                                    case BatchStatus.Upcoming:
                                        <span class="badge bg-primary">قادمة</span>
                                        break;
                                    case BatchStatus.InProgress:
                                        <span class="badge bg-success">جارية</span>
                                        break;
                                    case BatchStatus.Completed:
                                        <span class="badge bg-secondary">مكتملة</span>
                                        break;
                                    case BatchStatus.Cancelled:
                                        <span class="badge bg-danger">ملغاة</span>
                                        break;
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@batch.Id" class="btn btn-sm btn-outline-primary" title="تعديل">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@batch.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذه الدفعة؟')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-4">
        <i class="bi bi-info-circle me-2"></i>لا توجد دفعات. <a asp-action="Create">أضف دفعة جديدة</a>
    </div>
}
