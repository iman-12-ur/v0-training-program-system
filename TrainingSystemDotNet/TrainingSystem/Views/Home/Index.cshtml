@model HomeViewModel
@{
    ViewData["Title"] = "البرامج التدريبية";
}

<!-- Welcome Section -->
<div class="bg-light rounded-4 p-5 mb-5">
    <h1 class="display-5 fw-bold text-primary">@Model.WelcomeTitle</h1>
    <p class="lead text-muted">@Model.WelcomeDescription</p>
</div>

<!-- Search and Filter -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="ابحث عن برنامج..." value="@Model.SearchQuery">
                </div>
            </div>
            <div class="col-md-4">
                <select name="category" class="form-select">
                    <option value="">جميع التصنيفات</option>
                    @foreach (var cat in Model.AllCategories)
                    {
                        <option value="@cat" selected="@(Model.CategoryFilter == cat)">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i>بحث
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Programs Grid -->
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @if (Model.Programs.Any())
    {
        @foreach (var program in Model.Programs)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm hover-shadow">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title text-primary mb-0">@program.Title</h5>
                            @if (program.Status == ProgramStatus.Active)
                            {
                                <span class="badge bg-success">نشط</span>
                            }
                        </div>
                        <p class="card-text text-muted small">@(program.Description.Length > 100 ? program.Description.Substring(0, 100) + "..." : program.Description)</p>
                        
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @if (!string.IsNullOrEmpty(program.Categories))
                            {
                                @foreach (var cat in program.Categories.Split(','))
                                {
                                    <span class="badge bg-light text-primary">@cat.Trim()</span>
                                }
                            }
                        </div>

                        <div class="small text-muted mb-3">
                            <div><i class="bi bi-clock me-2"></i>@program.Duration</div>
                            <div><i class="bi bi-person me-2"></i>@program.Instructor</div>
                            <div><i class="bi bi-geo-alt me-2"></i>@program.Location</div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">
                                <i class="bi bi-calendar3 me-1"></i>
                                @program.Batches.Count(b => b.Status == BatchStatus.Upcoming) دفعة متاحة
                            </span>
                            <a asp-action="ProgramDetails" asp-route-id="@program.Id" class="btn btn-outline-primary btn-sm">
                                التفاصيل <i class="bi bi-arrow-left"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle me-2"></i>لا توجد برامج تدريبية متاحة حالياً
            </div>
        </div>
    }
</div>
