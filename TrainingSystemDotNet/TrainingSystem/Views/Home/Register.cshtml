@model RegisterViewModel
@{
    ViewData["Title"] = "تسجيل في البرنامج";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0">
                    <i class="bi bi-pencil-square me-2"></i>تسجيل في البرنامج التدريبي
                </h4>
            </div>
            <div class="card-body p-4">
                <!-- Program Info -->
                <div class="alert alert-info mb-4">
                    <h5 class="alert-heading">@Model.Program.Title</h5>
                    <hr>
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-1"><strong>الدفعة:</strong> @Model.Batch.Name</p>
                            <p class="mb-0"><strong>التاريخ:</strong> @Model.Batch.StartDate.ToString("yyyy/MM/dd") - @Model.Batch.EndDate.ToString("yyyy/MM/dd")</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1"><strong>المدة:</strong> @Model.Program.Duration</p>
                            <p class="mb-0"><strong>الموقع:</strong> @Model.Program.Location</p>
                        </div>
                    </div>
                </div>

                <form asp-action="Register" method="post">
                    <input type="hidden" asp-for="Registration.BatchId" />
                    
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Registration.VisitorName" class="form-label"></label>
                            <input asp-for="Registration.VisitorName" class="form-control" placeholder="أدخل الاسم الكامل" />
                            <span asp-validation-for="Registration.VisitorName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Registration.EmployeeId" class="form-label"></label>
                            <input asp-for="Registration.EmployeeId" class="form-control" placeholder="أدخل الرقم الوظيفي (أرقام إنجليزية فقط)" dir="ltr" />
                            <span asp-validation-for="Registration.EmployeeId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Registration.Court" class="form-label"></label>
                            <input asp-for="Registration.Court" class="form-control" placeholder="أدخل الدائرة أو المحكمة" />
                            <span asp-validation-for="Registration.Court" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Registration.Department" class="form-label"></label>
                            <input asp-for="Registration.Department" class="form-control" placeholder="أدخل القسم" />
                            <span asp-validation-for="Registration.Department" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Registration.Email" class="form-label"></label>
                            <input asp-for="Registration.Email" class="form-control" type="email" placeholder="example@email.com" dir="ltr" />
                            <span asp-validation-for="Registration.Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Registration.Phone" class="form-label"></label>
                            <input asp-for="Registration.Phone" class="form-control" placeholder="05XXXXXXXX" dir="ltr" />
                            <span asp-validation-for="Registration.Phone" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-send me-2"></i>إرسال طلب الترشيح
                        </button>
                        <a asp-action="ProgramDetails" asp-route-id="@Model.Program.Id" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-right me-1"></i>رجوع
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
