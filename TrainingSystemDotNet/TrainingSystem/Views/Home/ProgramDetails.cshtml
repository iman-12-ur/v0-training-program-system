@model ProgramDetailsViewModel
@{
    ViewData["Title"] = Model.Program.Title;
}

<div class="row">
    <div class="col-lg-8">
        <!-- Program Header -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h1 class="h2 text-primary mb-0">@Model.Program.Title</h1>
                    @if (!string.IsNullOrEmpty(Model.Program.ProgramType))
                    {
                        <span class="badge bg-primary">@Model.Program.ProgramType</span>
                    }
                </div>
                
                @if (!string.IsNullOrEmpty(Model.Program.Categories))
                {
                    <div class="mb-3">
                        @foreach (var cat in Model.Program.Categories.Split(','))
                        {
                            <span class="badge bg-light text-secondary me-1">@cat.Trim()</span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Description -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent">
                <h5 class="mb-0"><i class="bi bi-file-text text-primary me-2"></i>وصف البرنامج</h5>
            </div>
            <div class="card-body">
                <p class="mb-0">@Model.Program.Description</p>
            </div>
        </div>

        <!-- Target Audience -->
        @if (!string.IsNullOrEmpty(Model.Program.TargetAudience))
        {
            <div class="card border-0 shadow-sm mb-4 border-start border-primary border-3">
                <div class="card-body">
                    <h5><i class="bi bi-people text-primary me-2"></i>الفئة المستهدفة</h5>
                    <p class="mb-0">@Model.Program.TargetAudience</p>
                </div>
            </div>
        }

        <!-- Objectives -->
        @if (!string.IsNullOrEmpty(Model.Program.Objectives))
        {
            <div class="card border-0 shadow-sm mb-4 bg-success bg-opacity-10">
                <div class="card-header bg-transparent">
                    <h5 class="mb-0 text-success"><i class="bi bi-bullseye me-2"></i>أهداف البرنامج</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        @foreach (var obj in Model.Program.Objectives.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <li class="mb-2">
                                <i class="bi bi-check-circle text-success me-2"></i>@obj.Trim()
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        <!-- Topics -->
        @if (!string.IsNullOrEmpty(Model.Program.Topics))
        {
            <div class="card border-0 shadow-sm mb-4 bg-info bg-opacity-10">
                <div class="card-header bg-transparent">
                    <h5 class="mb-0 text-info"><i class="bi bi-book me-2"></i>محاور البرنامج</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        @foreach (var topic in Model.Program.Topics.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <li class="mb-2">
                                <i class="bi bi-circle-fill text-info me-2" style="font-size: 0.5rem;"></i>@topic.Trim()
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        <!-- Prerequisites -->
        @if (!string.IsNullOrEmpty(Model.Program.Prerequisites))
        {
            <div class="card border-0 shadow-sm mb-4 bg-warning bg-opacity-10">
                <div class="card-header bg-transparent">
                    <h5 class="mb-0 text-warning"><i class="bi bi-exclamation-triangle me-2"></i>المتطلبات المسبقة</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        @foreach (var req in Model.Program.Prerequisites.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <li class="mb-2">
                                <i class="bi bi-exclamation-circle text-warning me-2"></i>@req.Trim()
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <!-- Program Info -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>معلومات البرنامج</h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-3 pb-3 border-bottom">
                        <div class="text-muted small">المدة</div>
                        <div class="fw-bold"><i class="bi bi-clock text-primary me-2"></i>@Model.Program.Duration</div>
                    </li>
                    <li class="mb-3 pb-3 border-bottom">
                        <div class="text-muted small">المدرب</div>
                        <div class="fw-bold"><i class="bi bi-person text-primary me-2"></i>@Model.Program.Instructor</div>
                    </li>
                    <li class="mb-3 pb-3 border-bottom">
                        <div class="text-muted small">الموقع</div>
                        <div class="fw-bold"><i class="bi bi-geo-alt text-primary me-2"></i>@Model.Program.Location</div>
                    </li>
                    @if (!string.IsNullOrEmpty(Model.Program.ProgramType))
                    {
                        <li>
                            <div class="text-muted small">نوع البرنامج</div>
                            <div class="fw-bold"><i class="bi bi-tag text-primary me-2"></i>@Model.Program.ProgramType</div>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Available Batches -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-calendar3 me-2"></i>الدفعات المتاحة</h5>
            </div>
            <div class="card-body">
                @if (Model.AvailableBatches.Any())
                {
                    @foreach (var batch in Model.AvailableBatches)
                    {
                        <div class="border rounded p-3 mb-3">
                            <h6 class="fw-bold mb-2">@batch.Name</h6>
                            <div class="small text-muted mb-2">
                                <i class="bi bi-calendar me-1"></i>
                                @batch.StartDate.ToString("yyyy/MM/dd") - @batch.EndDate.ToString("yyyy/MM/dd")
                            </div>
                            <div class="small text-muted mb-3">
                                <i class="bi bi-people me-1"></i>
                                @batch.CurrentParticipants / @batch.MaxParticipants مشارك
                            </div>
                            <a asp-action="Register" asp-route-programId="@Model.Program.Id" asp-route-batchId="@batch.Id" 
                               class="btn btn-success btn-sm w-100">
                                <i class="bi bi-pencil-square me-1"></i>سجّل الآن
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle me-2"></i>لا توجد دفعات متاحة حالياً
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i>العودة للبرامج
    </a>
</div>
