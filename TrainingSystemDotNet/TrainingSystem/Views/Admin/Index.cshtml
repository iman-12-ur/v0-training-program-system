@model DashboardViewModel
@{
    ViewData["Title"] = "لوحة التحكم";
}

<!-- Welcome -->
<div class="bg-light rounded-4 p-4 mb-4">
    <h2 class="text-primary">@Model.AdminWelcome</h2>
    <p class="text-muted mb-0">@Model.AdminDescription</p>
</div>

<!-- Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="mb-0">@Model.TotalPrograms</h3>
                        <small>إجمالي البرامج</small>
                    </div>
                    <i class="bi bi-journal-text" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="mb-0">@Model.ActivePrograms</h3>
                        <small>برامج نشطة</small>
                    </div>
                    <i class="bi bi-check-circle" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-warning text-dark">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="mb-0">@Model.PendingRegistrations</h3>
                        <small>طلبات قيد المراجعة</small>
                    </div>
                    <i class="bi bi-clock" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="mb-0">@Model.TotalRegistrations</h3>
                        <small>إجمالي الترشيحات</small>
                    </div>
                    <i class="bi bi-people" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent">
                <h5 class="mb-0"><i class="bi bi-lightning text-warning me-2"></i>إجراءات سريعة</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-controller="Programs" asp-action="Create" class="btn btn-outline-primary">
                        <i class="bi bi-plus-circle me-2"></i>إضافة برنامج جديد
                    </a>
                    <a asp-controller="Batches" asp-action="Create" class="btn btn-outline-success">
                        <i class="bi bi-calendar-plus me-2"></i>إضافة دفعة جديدة
                    </a>
                    <a asp-controller="Registrations" asp-action="Index" asp-route-status="Pending" class="btn btn-outline-warning">
                        <i class="bi bi-clock me-2"></i>مراجعة الطلبات المعلقة (@Model.PendingRegistrations)
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent">
                <h5 class="mb-0"><i class="bi bi-graph-up text-success me-2"></i>إحصائيات</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        الدفعات
                        <span class="badge bg-primary rounded-pill">@Model.TotalBatches</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        طلبات مقبولة
                        <span class="badge bg-success rounded-pill">@Model.ApprovedRegistrations</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        طلبات معلقة
                        <span class="badge bg-warning rounded-pill">@Model.PendingRegistrations</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Recent Registrations -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-clock-history text-info me-2"></i>آخر طلبات الترشيح</h5>
        <a asp-controller="Registrations" asp-action="Index" class="btn btn-sm btn-outline-primary">عرض الكل</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>الاسم</th>
                        <th>الرقم الوظيفي</th>
                        <th>البرنامج</th>
                        <th>الدفعة</th>
                        <th>التاريخ</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reg in Model.RecentRegistrations)
                    {
                        <tr>
                            <td>@reg.VisitorName</td>
                            <td dir="ltr">@reg.EmployeeId</td>
                            <td>@reg.Batch?.TrainingProgram?.Title</td>
                            <td>@reg.Batch?.Name</td>
                            <td>@reg.RegisteredAt.ToString("yyyy/MM/dd")</td>
                            <td>
                                @switch (reg.Status)
                                {
                                    case RegistrationStatus.Pending:
                                        <span class="badge bg-warning">قيد المراجعة</span>
                                        break;
                                    case RegistrationStatus.Approved:
                                        <span class="badge bg-success">مقبول</span>
                                        break;
                                    case RegistrationStatus.Rejected:
                                        <span class="badge bg-danger">مرفوض</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
