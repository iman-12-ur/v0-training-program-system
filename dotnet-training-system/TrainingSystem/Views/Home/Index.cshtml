@model PublicProgramViewModel
@{
    ViewData["Title"] = "الرئيسية";
}

<div class="container py-5">
    <!-- Hero Section -->
    <div class="bg-primary bg-gradient text-white rounded-4 p-5 mb-5">
        <h1 class="display-5 fw-bold">@Model.Settings?.WelcomeTitle</h1>
        <p class="lead mt-3">@Model.Settings?.WelcomeDescription</p>
    </div>

    <!-- Search & Filter -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="البحث في البرامج..." value="@Model.SearchQuery">
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="category" class="form-select">
                        <option value="">جميع التصنيفات</option>
                        @foreach (var cat in Model.AllCategories)
                        {
                            <option value="@cat" selected="@(Model.CategoryFilter == cat)">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i>
                        فلترة
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Programs Grid -->
    @if (Model.Programs.Any())
    {
        <div class="row g-4">
            @foreach (var program in Model.Programs)
            {
                var hasAvailableBatches = program.Batches.Any(b => b.Status == BatchStatus.Upcoming && !b.IsFull);
                
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 hover-shadow">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    @if (!string.IsNullOrEmpty(program.ProgramType))
                                    {
                                        <span class="badge bg-primary mb-2">@program.ProgramType</span>
                                    }
                                    <h5 class="card-title fw-bold">@program.Title</h5>
                                </div>
                                @if (!string.IsNullOrEmpty(program.LogoUrl))
                                {
                                    <img src="@program.LogoUrl" alt="شعار" class="rounded" style="width: 50px; height: 50px; object-fit: contain;">
                                }
                            </div>
                            
                            <p class="card-text text-muted small">
                                @(program.Description.Length > 100 ? program.Description.Substring(0, 100) + "..." : program.Description)
                            </p>

                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @foreach (var cat in program.CategoriesList.Take(2))
                                {
                                    <span class="badge bg-light text-dark">@cat</span>
                                }
                            </div>

                            <div class="small text-muted mb-3">
                                <div class="d-flex align-items-center mb-1">
                                    <i class="bi bi-person me-2"></i>
                                    <span>@program.Instructor</span>
                                </div>
                                <div class="d-flex align-items-center mb-1">
                                    <i class="bi bi-clock me-2"></i>
                                    <span>@program.Duration</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-geo-alt me-2"></i>
                                    <span>@program.Location</span>
                                </div>
                            </div>

                            @if (hasAvailableBatches)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>
                                    التسجيل متاح
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-x-circle me-1"></i>
                                    التسجيل مغلق
                                </span>
                            }
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            <div class="d-flex gap-2">
                                <a asp-action="ProgramDetails" asp-route-id="@program.Id" class="btn btn-outline-primary flex-grow-1">
                                    <i class="bi bi-info-circle me-1"></i>
                                    التفاصيل
                                </a>
                                @if (hasAvailableBatches)
                                {
                                    <a asp-action="Register" asp-route-programId="@program.Id" class="btn btn-primary flex-grow-1">
                                        <i class="bi bi-pencil-square me-1"></i>
                                        تسجيل
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">لا توجد برامج متاحة حالياً</h4>
        </div>
    }
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        transition: all 0.3s ease;
    }
    .card {
        transition: all 0.3s ease;
    }
</style>
