@model TrainingProgram
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">الرئيسية</a></li>
            <li class="breadcrumb-item active">@Model.Title</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <!-- Program Header -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="d-flex gap-2 mb-2">
                                @foreach (var cat in Model.CategoriesList)
                                {
                                    <span class="badge bg-secondary">@cat</span>
                                }
                                @if (!string.IsNullOrEmpty(Model.ProgramType))
                                {
                                    <span class="badge bg-primary">@Model.ProgramType</span>
                                }
                            </div>
                            <h2 class="fw-bold">@Model.Title</h2>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.LogoUrl))
                        {
                            <img src="@Model.LogoUrl" alt="شعار البرنامج" class="rounded border" style="width: 80px; height: 80px; object-fit: contain;">
                        }
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-file-text text-primary me-2"></i>
                        وصف البرنامج
                    </h5>
                    <p class="text-muted" style="white-space: pre-line;">@Model.Description</p>
                </div>
            </div>

            <!-- Target Audience -->
            @if (!string.IsNullOrEmpty(Model.TargetAudience))
            {
                <div class="card shadow-sm mb-4 border-primary">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">
                            <i class="bi bi-people text-primary me-2"></i>
                            الفئة المستهدفة
                        </h5>
                        <p class="mb-0">@Model.TargetAudience</p>
                    </div>
                </div>
            }

            <!-- Objectives -->
            @if (Model.ObjectivesList.Any())
            {
                <div class="card shadow-sm mb-4 border-success">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3 text-success">
                            <i class="bi bi-bullseye me-2"></i>
                            أهداف البرنامج
                        </h5>
                        <ul class="list-unstyled mb-0">
                            @foreach (var obj in Model.ObjectivesList)
                            {
                                <li class="d-flex align-items-start mb-2">
                                    <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                    <span>@obj</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <!-- Topics -->
            @if (Model.TopicsList.Any())
            {
                <div class="card shadow-sm mb-4 border-info">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3 text-info">
                            <i class="bi bi-book me-2"></i>
                            محاور البرنامج
                        </h5>
                        <ul class="list-unstyled mb-0">
                            @foreach (var topic in Model.TopicsList)
                            {
                                <li class="d-flex align-items-start mb-2">
                                    <i class="bi bi-circle-fill text-info me-2 mt-1" style="font-size: 0.5rem;"></i>
                                    <span>@topic</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <!-- Prerequisites -->
            @if (Model.PrerequisitesList.Any())
            {
                <div class="card shadow-sm mb-4 border-warning">
                    <div class="card-body bg-warning bg-opacity-10">
                        <h5 class="fw-bold mb-3 text-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            المتطلبات المسبقة
                        </h5>
                        <ul class="list-unstyled mb-0">
                            @foreach (var prereq in Model.PrerequisitesList)
                            {
                                <li class="d-flex align-items-start mb-2">
                                    <i class="bi bi-exclamation-circle text-warning me-2 mt-1"></i>
                                    <span>@prereq</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <!-- Program Info Card -->
            <div class="card shadow-sm mb-4 sticky-top" style="top: 20px;">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        معلومات البرنامج
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                        <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                            <i class="bi bi-person text-primary"></i>
                        </div>
                        <div>
                            <small class="text-muted">المدرب</small>
                            <div class="fw-bold">@Model.Instructor</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                        <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                            <i class="bi bi-clock text-primary"></i>
                        </div>
                        <div>
                            <small class="text-muted">المدة</small>
                            <div class="fw-bold">@Model.Duration</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                            <i class="bi bi-geo-alt text-primary"></i>
                        </div>
                        <div>
                            <small class="text-muted">الموقع</small>
                            <div class="fw-bold">@Model.Location</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Batches -->
            @if (Model.Batches.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-calendar3 me-2"></i>
                            الدفعات المتاحة
                        </h5>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var batch in Model.Batches.Where(b => b.Status == BatchStatus.Upcoming))
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong>@batch.Name</strong>
                                    @if (batch.IsFull)
                                    {
                                        <span class="badge bg-danger">مكتمل</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">متاح</span>
                                    }
                                </div>
                                <small class="text-muted d-block">
                                    <i class="bi bi-calendar me-1"></i>
                                    @batch.StartDate.ToString("yyyy/MM/dd") - @batch.EndDate.ToString("yyyy/MM/dd")
                                </small>
                                <small class="text-muted d-block">
                                    <i class="bi bi-people me-1"></i>
                                    @batch.CurrentParticipants / @batch.MaxParticipants مشارك
                                </small>
                                @if (!batch.IsFull)
                                {
                                    <a asp-action="Register" asp-route-programId="@Model.Id" asp-route-batchId="@batch.Id" 
                                       class="btn btn-primary btn-sm w-100 mt-2">
                                        <i class="bi bi-pencil-square me-1"></i>
                                        سجل الآن
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
