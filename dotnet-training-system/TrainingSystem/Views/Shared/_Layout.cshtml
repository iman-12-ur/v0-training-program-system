<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام البرامج التدريبية</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Admin Layout -->
        <div class="d-flex">
            <!-- Sidebar -->
            <nav class="sidebar bg-dark text-white" style="width: 280px; min-height: 100vh; position: fixed;">
                <div class="p-4 border-bottom border-secondary">
                    <h5 class="mb-0">
                        <i class="bi bi-mortarboard-fill me-2"></i>
                        نظام التدريب
                    </h5>
                </div>
                <div class="p-3">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active bg-primary rounded" : "")" 
                               asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-speedometer2 me-2"></i>
                                لوحة التحكم
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Programs" ? "active bg-primary rounded" : "")" 
                               asp-controller="Programs" asp-action="Index">
                                <i class="bi bi-collection me-2"></i>
                                البرامج التدريبية
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Batches" ? "active bg-primary rounded" : "")" 
                               asp-controller="Batches" asp-action="Index">
                                <i class="bi bi-calendar3 me-2"></i>
                                إدارة الدفعات
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Registrations" ? "active bg-primary rounded" : "")" 
                               asp-controller="Registrations" asp-action="Index">
                                <i class="bi bi-person-lines-fill me-2"></i>
                                طلبات الترشيح
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active bg-primary rounded" : "")" 
                               asp-controller="Settings" asp-action="Index">
                                <i class="bi bi-gear me-2"></i>
                                الإعدادات
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="mt-auto p-3 border-top border-secondary position-absolute bottom-0 w-100">
                    <a class="nav-link text-white" asp-controller="Home" asp-action="Index" target="_blank">
                        <i class="bi bi-box-arrow-up-left me-2"></i>
                        عرض الموقع
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="nav-link text-white bg-transparent border-0 w-100 text-start">
                            <i class="bi bi-box-arrow-right me-2"></i>
                            تسجيل الخروج
                        </button>
                    </form>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="flex-grow-1" style="margin-right: 280px;">
                <div class="p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i>
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @RenderBody()
                </div>
            </main>
        </div>
    }
    else
    {
        <!-- Public Layout -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill text-primary me-2"></i>
                    نظام البرامج التدريبية
                </a>
                <div class="navbar-nav me-auto">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">الرئيسية</a>
                </div>
                <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-person me-1"></i>
                    دخول المسؤولين
                </a>
            </div>
        </nav>

        <main>
            @RenderBody()
        </main>

        <footer class="bg-dark text-white py-4 mt-5">
            <div class="container text-center">
                <p class="mb-0">
                    <i class="bi bi-c-circle me-1"></i>
                    @DateTime.Now.Year جميع الحقوق محفوظة - نظام البرامج التدريبية
                </p>
            </div>
        </footer>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
