@model DashboardViewModel
@{
    ViewData["Title"] = "لوحة التحكم";
}

<div class="mb-4">
    <h4 class="fw-bold">@Model.Settings?.AdminWelcome @Model.AdminName</h4>
    <p class="text-muted">@Model.Settings?.AdminDescription</p>
</div>

<!-- Statistics Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">البرامج النشطة</h6>
                        <h2 class="fw-bold text-primary mb-0">@Model.ActivePrograms</h2>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-collection text-primary fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">طلبات قيد المراجعة</h6>
                        <h2 class="fw-bold text-warning mb-0">@Model.PendingRegistrations</h2>
                    </div>
                    <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-hourglass-split text-warning fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">الطلبات المقبولة</h6>
                        <h2 class="fw-bold text-success mb-0">@Model.ApprovedRegistrations</h2>
                    </div>
                    <div class="bg-success bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-check-circle text-success fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">الدفعات القادمة</h6>
                        <h2 class="fw-bold text-info mb-0">@Model.UpcomingBatches</h2>
                    </div>
                    <div class="bg-info bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-calendar3 text-info fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Programs -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-collection me-2"></i>
                    آخر البرامج المضافة
                </h5>
                <a asp-controller="Programs" asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>
                    إضافة برنامج
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentPrograms.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var program in Model.RecentPrograms)
                        {
                            <a asp-controller="Programs" asp-action="Details" asp-route-id="@program.Id" 
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">@program.Title</h6>
                                    <small class="text-muted">@program.Instructor</small>
                                </div>
                                <span class="badge @(program.Status == ProgramStatus.Active ? "bg-success" : "bg-secondary")">
                                    @(program.Status == ProgramStatus.Active ? "نشط" : "غير نشط")
                                </span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mb-0">لا توجد برامج</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Registrations -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-person-lines-fill me-2"></i>
                    آخر طلبات الترشيح
                </h5>
                <a asp-controller="Registrations" asp-action="Index" class="btn btn-outline-primary btn-sm">
                    عرض الكل
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentRegistrations.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>الموظف</th>
                                    <th>البرنامج</th>
                                    <th>الحالة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reg in Model.RecentRegistrations)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@reg.EmployeeName</div>
                                            <small class="text-muted">@reg.EmployeeId</small>
                                        </td>
                                        <td>@reg.TrainingProgram?.Title</td>
                                        <td>
                                            <span class="badge @reg.StatusBadgeClass">@reg.StatusDisplay</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mb-0">لا توجد طلبات</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
