@model ProgramListViewModel
@{
    ViewData["Title"] = "البرامج التدريبية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">البرامج التدريبية</h4>
        <p class="text-muted mb-0">إدارة جميع البرامج التدريبية</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>
        إضافة برنامج جديد
    </a>
</div>

<!-- Filters -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="search" class="form-control" placeholder="البحث..." value="@Model.SearchQuery">
            </div>
            <div class="col-md-3">
                <select name="category" class="form-select">
                    <option value="">جميع التصنيفات</option>
                    @foreach (var cat in Model.AllCategories)
                    {
                        <option value="@cat" selected="@(Model.CategoryFilter == cat)">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">جميع الحالات</option>
                    <option value="@ProgramStatus.Active" selected="@(Model.StatusFilter == ProgramStatus.Active)">نشط</option>
                    <option value="@ProgramStatus.Inactive" selected="@(Model.StatusFilter == ProgramStatus.Inactive)">غير نشط</option>
                    <option value="@ProgramStatus.Draft" selected="@(Model.StatusFilter == ProgramStatus.Draft)">مسودة</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-funnel me-1"></i>
                    فلترة
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Programs Table -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (Model.Programs.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40%">البرنامج</th>
                            <th>المدرب</th>
                            <th>المدة</th>
                            <th>الدفعات</th>
                            <th>الحالة</th>
                            <th style="width: 150px">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var program in Model.Programs)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(program.LogoUrl))
                                        {
                                            <img src="@program.LogoUrl" alt="" class="rounded me-3" style="width: 48px; height: 48px; object-fit: contain;">
                                        }
                                        else
                                        {
                                            <div class="bg-primary bg-opacity-10 rounded d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                                                <i class="bi bi-mortarboard text-primary"></i>
                                            </div>
                                        }
                                        <div>
                                            <h6 class="mb-0">@program.Title</h6>
                                            <small class="text-muted">@program.CategoriesList.FirstOrDefault()</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@program.Instructor</td>
                                <td>@program.Duration</td>
                                <td>
                                    <span class="badge bg-info">@program.Batches.Count دفعة</span>
                                </td>
                                <td>
                                    @if (program.Status == ProgramStatus.Active)
                                    {
                                        <span class="badge bg-success">نشط</span>
                                    }
                                    else if (program.Status == ProgramStatus.Inactive)
                                    {
                                        <span class="badge bg-secondary">غير نشط</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">مسودة</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@program.Id" class="btn btn-outline-primary" title="عرض">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@program.Id" class="btn btn-outline-primary" title="تعديل">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@program.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-warning" title="تغيير الحالة">
                                                <i class="bi bi-toggle-on"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Delete" asp-route-id="@program.Id" method="post" class="d-inline" 
                                              onsubmit="return confirm('هل أنت متأكد من حذف هذا البرنامج؟')">
                                            <button type="submit" class="btn btn-outline-danger" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav class="p-3 border-top">
                    <ul class="pagination justify-content-center mb-0">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-search="@Model.SearchQuery"
                                   asp-route-category="@Model.CategoryFilter"
                                   asp-route-status="@Model.StatusFilter"
                                   asp-route-page="@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox display-1"></i>
                <h5 class="mt-3">لا توجد برامج</h5>
                <a asp-action="Create" class="btn btn-primary mt-2">إضافة برنامج جديد</a>
            </div>
        }
    </div>
</div>
