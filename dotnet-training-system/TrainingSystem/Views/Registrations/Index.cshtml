@model RegistrationListViewModel
@{
    ViewData["Title"] = "طلبات الترشيح";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">طلبات الترشيح</h4>
        <p class="text-muted mb-0">إدارة ومراجعة طلبات الترشيح للبرامج التدريبية</p>
    </div>
    <a asp-action="ExportToExcel" asp-route-programId="@Model.ProgramFilter" asp-route-status="@Model.StatusFilter" class="btn btn-success">
        <i class="bi bi-file-earmark-excel me-1"></i>
        تصدير Excel
    </a>
</div>

<!-- Filters -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="search" class="form-control" placeholder="البحث بالاسم أو الرقم الوظيفي..." value="@Model.SearchQuery">
            </div>
            <div class="col-md-3">
                <select name="programId" class="form-select">
                    <option value="">جميع البرامج</option>
                    @foreach (var prog in Model.AllPrograms)
                    {
                        <option value="@prog.Id" selected="@(Model.ProgramFilter == prog.Id)">@prog.Title</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">جميع الحالات</option>
                    <option value="@RegistrationStatus.Pending" selected="@(Model.StatusFilter == RegistrationStatus.Pending)">قيد المراجعة</option>
                    <option value="@RegistrationStatus.Approved" selected="@(Model.StatusFilter == RegistrationStatus.Approved)">مقبول</option>
                    <option value="@RegistrationStatus.Rejected" selected="@(Model.StatusFilter == RegistrationStatus.Rejected)">مرفوض</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-funnel me-1"></i>
                    فلترة
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Registrations Table -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (Model.Registrations.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>الموظف</th>
                            <th>الدائرة / القسم</th>
                            <th>البرنامج</th>
                            <th>الدفعة</th>
                            <th>تاريخ التسجيل</th>
                            <th>الحالة</th>
                            <th style="width: 150px">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reg in Model.Registrations)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@reg.EmployeeName</div>
                                    <small class="text-muted">@reg.EmployeeId</small>
                                </td>
                                <td>
                                    <div>@reg.Court</div>
                                    <small class="text-muted">@reg.Department</small>
                                </td>
                                <td>@reg.TrainingProgram?.Title</td>
                                <td>@reg.Batch?.Name</td>
                                <td>
                                    <small>@reg.RegisteredAt.ToString("yyyy/MM/dd")</small>
                                    <br>
                                    <small class="text-muted">@reg.RegisteredAt.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <span class="badge @reg.StatusBadgeClass">@reg.StatusDisplay</span>
                                </td>
                                <td>
                                    @if (reg.Status == RegistrationStatus.Pending)
                                    {
                                        <div class="btn-group btn-group-sm">
                                            <form asp-action="Approve" asp-route-id="@reg.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-success" title="قبول">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-danger" title="رفض" 
                                                    data-bs-toggle="modal" data-bs-target="#rejectModal-@reg.Id">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                            <a asp-action="Details" asp-route-id="@reg.Id" class="btn btn-outline-primary" title="التفاصيل">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </div>

                                        <!-- Reject Modal -->
                                        <div class="modal fade" id="rejectModal-@reg.Id" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form asp-action="Reject" asp-route-id="@reg.Id" method="post">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">رفض الطلب</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label">سبب الرفض (اختياري)</label>
                                                                <textarea name="reason" class="form-control" rows="3" placeholder="أدخل سبب الرفض..."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                                                            <button type="submit" class="btn btn-danger">تأكيد الرفض</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@reg.Id" class="btn btn-outline-primary" title="التفاصيل">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@reg.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('هل أنت متأكد من حذف هذا الطلب؟')">
                                                <button type="submit" class="btn btn-outline-danger" title="حذف">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav class="p-3 border-top">
                    <ul class="pagination justify-content-center mb-0">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-search="@Model.SearchQuery"
                                   asp-route-programId="@Model.ProgramFilter"
                                   asp-route-status="@Model.StatusFilter"
                                   asp-route-page="@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox display-1"></i>
                <h5 class="mt-3">لا توجد طلبات</h5>
            </div>
        }
    </div>
</div>
