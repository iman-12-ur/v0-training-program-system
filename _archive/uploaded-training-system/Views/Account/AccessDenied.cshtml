@{
    ViewData["Title"] = "غير مصرح لك";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام إدارة البرامج التدريبية للمجلس الأعلى للقضاء</title>
    
    <!-- Fonts -->
        <link href="~/font/notosansarabic-variablefont_wdth,wght.ttf"/>
    
    <!-- Bootstrap Icons -->
   
 <link href="~/font/bootstrap-icons.min.css" rel="stylesheet" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="access-denied-container">
        <div class="access-denied-card animate-slideIn">
            <div class="access-denied-icon">
                <i class="bi bi-shield-lock"></i>
            </div>
            <h1>عذرا، لا يمكنك الوصول</h1>
            <p>
                ليس لديك الصلاحية الكافية للوصول إلى هذه الصفحة.
                <br>
                يرجى التواصل مع مدير النظام إذا كنت تعتقد أن هذا خطأ.
            </p>
            <div class="access-denied-actions">
                <a href="/" class="btn btn-secondary">
                    <i class="bi bi-house-door me-2"></i>
                    الصفحة الرئيسية
                </a>
                <a href="javascript:history.back()" class="btn btn-primary">
                    <i class="bi bi-arrow-right me-2"></i>
                    العودة للخلف
                </a>
            </div>
        </div>
    </div>
</body>
</html>
